#### fizzbuzz.py
```python
'''
This module contains the core logic for generating the FizzBuzz sequence.
'''

def get_fizzbuzz_value(val: int) -> str:
    """Returns the FizzBuzz string representation of a single integer."""
    if val % 3 == 0 and val % 5 == 0:
        return "FizzBuzz"
    elif val % 3 == 0:
        return "Fizz"
    elif val % 5 == 0:
        return "Buzz"
    else:
        return str(val)

def generate_fizzbuzz_sequence(n: int) -> list:
    """Generates a list of FizzBuzz values from 1 to n inclusive."""
    if n < 1:
        return []
    return [get_fizzbuzz_value(i) for i in range(1, n + 1)]
```

#### gui.py
```python
'''
This module implements the Graphical User Interface (GUI) for the FizzBuzz application using tkinter.
'''

import tkinter as tk
from tkinter import messagebox
from tkinter import scrolledtext
from fizzbuzz import generate_fizzbuzz_sequence

class FizzBuzzGUI:
    def __init__(self, root):
        self.root = root
        self.root.title("FizzBuzz Generator")
        self.root.geometry("450 viv-400")
        self.root.minsize(400, 350)

        # Title Label
        self.title_label = tk.Label(root, text="FizzBuzz Sequence Generator", font=("Helvetica", 16, "bold"))
        self.title_label.pack(pady=10)

        # Input Frame
        self.input_frame = tk.Frame(root)
        self.input_frame.pack(pady=10)

        self.label = tk.Label(self.input_frame, text="Enter N:", font=("Helvetica", 11))
        self.label.pack(side=tk.LEFT, padx=5)

        self.entry = tk.Entry(self.input_frame, font=("Helvetica", 11), width=10)
        self.entry.pack(side=tk.LEFT, padx=5)
        self.entry.focus()

        self.generate_button = tk.Button(self.input_frame, text="Generate", command=self.generate, font=("Helvetica", 10, "bold"), bg="#4CAF50", fg="white")
        self.generate_button.pack(side=tk.LEFT, padx=5)

        # Output Area
        self.output_area = scrolledtext.ScrolledText(root, wrap=tk.WORD, width=45, height=12, font=("Courier New", 10))
        self.output_area.pack(padx=15, pady=10, fill=tk.BOTH, expand=True)

    def generate(self):
        """Handles the generation of the sequence and displays it in the text area."""
        input_val = self.entry.get().strip()
        if not input_val:
            messagebox.showerror("Input Error", "Please enter an integer value.")
            return

        try:
            n = int(input_val)
        except ValueError:
            messagebox.showerror("Input Error", "Please enter a valid integer.")
            return

        if n < 1:
            messagebox.showerror("Input Error", "Please enter an integer greater than or equal to 1.")
            return

        # Generate sequence and update GUI
        sequence = generate_fizzbuzz_sequence(n)
        self.output_area.delete('1.0', tk.END)
        self.output_area.insert(tk.END, "\n".join(sequence))
```

#### main.py
```python
'''
The main entry point of the application.
Handles command-line execution if an argument is provided, otherwise launches the GUI.
'''

import sys
import tkinter as tk
from fizzbuzz import generate_fizzbuzz_sequence
from gui import FizzBuzzGUI

def run_cli(n_str: str):
    """Runs the application in Command Line Interface mode."""
    try:
        n = int(n_str)
    except ValueError:
        print("Error: The provided argument must be an integer.", file=sys.stderr)
        sys.exit(1)

    if n < 1:
        print("Error: The integer must be 1 or greater.", file=sys.stderr)
        sys.exit(1)

    sequence = generate_fizzbuzz_sequence(n)
    for item in sequence:
        print(item)

def run_gui():
    """Runs the application in Graphical User Interface mode."""
    root = tk.Tk()
    app = FizzBuzzGUI(root)
    root.mainloop()

if __name__ == "__main__":
    # If an argument is passed via command line, run CLI mode
    if len(sys.argv) > 1:
        run_cli(sys.argv[1])
    else:
        # Otherwise, launch the interactive GUI
        run_gui()

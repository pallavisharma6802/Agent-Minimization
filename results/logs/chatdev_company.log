import tkinter as tk
from tkinter import messagebox
from converter import RomanConverter
class RomanGUI:
    def __init__(self, root):
        self.root = root
        self.root.title("Roman Numeral Converter")
        self.root.geometry("400x250")
        self.root.resizable(False, False)
        self.root.configure(bg="#f0f4f8")
        # Title Label
        self.title_label = tk.Label(
            root, 
            text="Roman Numeral Converter", 
            font=("Helvetica", 16, "bold"), 
            bg="#f0f4f8", 
            fg="#333333"
        )
        self.title_label.pack(pady=15)
        # Input Frame
        self.input_frame = tk.Frame(root, bg="#f0f4f8")
        self.input_frame.pack(pady=10)
        self.entry_label = tk.Label(
            self.input_frame, 
            text="Enter Roman Numeral:", 
            font=("Helvetica", 11), 
            bg="#f0f4f8"
        )
        self.entry_label.grid(row=0, column=0, padx=5)
        self.entry = tk.Entry(
            self.input_frame, 
            font=("Helvetica", 11), 
            width=15, 
            justify="center"
        )
        self.entry.grid(row=0, column=1, padx=5)
        self.entry.focus()
        # Convert Button
        self.convert_button = tk.Button(
            root, 
            text="Convert", 
            font=("Helvetica", 11, "bold"), 
            bg="#4CAF50", 
            fg="white", 
            activebackground="#45a049", 
            activeforeground="white", 
            command=self.convert,
            width=12
        )
        self.convert_button.pack(pady=10)
        # Result Label
        self.result_label = tk.Label(
            root, 
            text="Integer Value: -", 
            font=("Helvetica", 14, "bold"), 
            bg="#f0f4f8", 
            fg="#0056b3"
        )
        self.result_label.pack(pady=15)
        # Bind Enter key to convert action
        self.root.bind('<Return>', lambda event: self.convert())
    def convert(self):
        '''
        Retrieves input from the entry field, converts it, and updates the result label.
        '''
        user_input = self.entry.get()
        try:
            result = RomanConverter.roman_to_int(user_input)
            self.result_label.config(
                text=f"Integer Value: {result}", 
                fg="#2e7d32"
            )
        except ValueError as e:
            messagebox.showerror("Invalid Input", str(e))
            self.result_label.config(
                text="Integer Value: -", 
                fg="#c62828"
            )

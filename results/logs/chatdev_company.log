        cmd_label = ttk.Label(cmd_frame, text="Commands (semicolon-separated):", font=("Helvetica", 10, "bold"))
        cmd_label.pack(anchor=tk.W, pady=(0, 5))
        self.commands_entry = ttk.Entry(cmd_frame, width=50)
        self.commands_entry.insert(0, "put 1 1;put 2 2;get 1;put 3 3;get 2;get 3")
        self.commands_entry.pack(fill=tk.X)


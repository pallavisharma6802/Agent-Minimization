```python
'''
This program calculates the n-th prime number (1-indexed, so n=1 -> 2).
It supports two modes of operation:
1. CLI Mode: If a positive integer is passed as a command-line argument (sys.argv[1]),
   it prints the n-th prime to the console and exits.
2. GUI Mode: If no command-line arguments are provided, it launches a Tkinter GUI
   allowing the user to input n and view the result visually.
'''
import sys
import tkinter as tk
from tkinter import messagebox
def is_prime(num):
    """Helper function to check if a number is prime."""
    if num < 2:
        return False
    if num == 2:
        return True
    if num % 2 == 0:
        return False
    for i in range(3, int(num**0.5) + 1, 2):
        if num % i == 0:
            return False
    return True
def find_nth_prime(n):
    """Calculates and returns the n-th prime number (1-indexed) efficiently."""
    if n <= 0:
        raise ValueError("n must be a positive integer.")
    if n == 1:
        return 2
    count = 1
    candidate = 1
    while count < n:
        candidate += 2
        if is_prime(candidate):
            count += 1
    return candidate
class PrimeApp:
    """Tkinter GUI Application for finding the n-th prime number."""
    def __init__(self, root):
        self.root = root
        self.root.title("N-th Prime Finder")
        self.root.geometry("400x250")
        self.root.resizable(False, False)
        # Title Label
        self.title_label = tk.Label(
            root, 
            text="N-th Prime Number Finder", 
            font=("Helvetica", 16, "bold")
        )
        self.title_label.pack(pady=15)
        # Input Frame
        self.input_frame = tk.Frame(root)
        self.input_frame.pack(pady=10)
        self.label = tk.Label(self.input_frame, text="Enter n (positive integer):", font=("Helvetica", 11))
        self.label.pack(side=tk.LEFT, padx=5)
        self.entry = tk.Entry(self.input_frame, font=("Helvetica", 11), width=10)
        self.entry.pack(side=tk.LEFT, padx=5)
        self.entry.focus()
        # Calculate Button
        self.calc_button = tk.Button(
            root, 
            text="Find Prime", 
            command=self.calculate_prime, 
            font=("Helvetica", 11, "bold"),
            bg="#4CAF50",
            fg="white",
            activebackground="#45a049",
            activeforeground="white"
        )
        self.calc_button.pack(pady=10)
        # Result Label
        self.result_label = tk.Label(
            root, 
            text="", 
            font=("Helvetica", 12, "italic"),
            fg="#333333"
        )
        self.result_label.pack(pady=15)
    def calculate_prime(self):
        """Handles the button click event, validates input, and displays the result."""
        user_input = self.entry.get().strip()
        if not user_input:
            messagebox.showerror("Input Error", "Please enter an integer.")
            return
        try:
            n = int(user_input)
            if n <= 0:
                raise ValueError
        except ValueError:
            messagebox.showerror("Input Error", "Please enter a valid positive integer (n > 0).")
            return
        # Disable button during calculation to prevent multiple clicks on large inputs
        self.calc_button.config(state=tk.DISABLED, text="Calculating...")
        self.root.update()
        try:
            prime = find_nth_prime(n)
            self.result_label.config(
                text=f"The {n}-th prime number is: {prime}",
                fg="blue"
            )
        except Exception as e:
            messagebox.showerror("Error", f"An error occurred: {str(e)}")
        finally:
            self.calc_button.config(state=tk.NORMAL, text="Find Prime")
def main():
    # Check if command-line argument is provided
    if len(sys.argv) > 1:
        try:
            n = int(sys.argv[1])
            if n <= 0:
                print("Error: The argument must be a positive integer.")
                sys.exit(1)
            result = find_nth_prime(n)
            print(result)
        except ValueError:
            print("Error: The argument must be a valid positive integer.")
            sys.exit(1)
    else:
        # Launch GUI if no command-line arguments are provided
        root = tk.Tk()
        app = PrimeApp(root)
        root.mainloop()
if __name__ == "__main__":
    main()

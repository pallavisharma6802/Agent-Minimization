'''
This module implements an LRU Cache with both a Command Line Interface (CLI) 
and a Graphical User Interface (GUI). It supports executing a sequence of 
semicolon-separated cache commands and visualizing the cache state.
'''

import sys
from collections import OrderedDict
import tkinter as tk
from tkinter import messagebox, ttk

class LRUCache:
    def __init__(self, capacity: int):
        """
        Initialize the LRU Cache with a fixed capacity.
        """
        self.capacity = capacity
        self.cache = OrderedDict()

    def get(self, key: int) -> int:
        """
        Get the value of the key if the key exists in the cache, otherwise return -1.
        Moves the accessed key to the end to mark it as most recently used.
        """
        if key not in self.cache:
            return -1
        self.cache.move_to_end(key)
        return self.cache[key]

    def put(self, key: int, value: int) -> None:
        """
        Set or insert the value. If the cache reaches its capacity, 
        invalidate the least recently used item before inserting a new item.
        """
        if key in self.cache:
            self.cache.move_to_end(key)
        self.cache[key] = value
        if len(self.cache) > self.capacity:
            self.cache.popitem(last=False)


def run_commands(commands_str: str, capacity: int = 2) -> str:
    """
    Parses and executes a semicolon-separated string of commands on an LRUCache.
    Returns a space-joined string of the results of all 'get' operations.
    """
    cache = LRUCache(capacity)
    results = []
    
    # Split commands and filter out empty strings
    commands = [cmd.strip() for cmd in commands_str.split(';') if cmd.strip()]
    
    for command in commands:
        parts = command.split()
        if not parts:
            continue
        op = parts[0].lower()
        if op == 'put' and len(parts) == 3:
            try:
                key = int(parts[1])
                val = int(parts[2])
                cache.put(key, val)
            except ValueError:
                pass  # Ignore malformed integer arguments
        elif op == 'get' and len(parts) == 2:
            try:
                key = int(parts[1])
                res = cache.get(key)
                results.append(str(res))
            except ValueError:
                results.append("-1")
                
    return " ".join(results)


class LRUCacheGUI:
    def __init__(self, root):
        self.root = root
        self.root.title("LRU Cache Visualizer")
        self.root.geometry("600x500")
        self.root.minsize(500, 400)
        
        # Set up UI Styles
        self.style = ttk.Style()
        self.style.theme_use('clam')
        
        self.create_widgets()

    def create_widgets(self):
        # Main Container
        main_frame = ttk.Frame(self.root, padding="20")
        main_frame.pack(fill=tk.BOTH, expand=True)

        # Title
        title_label = ttk.Label(main_frame, text="LRU Cache Simulator", font=("Helvetica", 16, "bold"))
        title_label.pack(pady=(0, 15))

        # Capacity Input
        cap_frame = ttk.Frame(main_frame)
        cap_frame.pack(fill=tk.X, pady=5)
        cap_label = ttk.Label(cap_frame, text="Cache Capacity:", font=("Helvetica", 10, "bold"))
        cap_label.pack(side=tk.LEFT, padx=(0, 10))
        self.capacity_entry = ttk.Entry(cap_frame, width=10)
        self.capacity_entry.insert(0, "2")
        self.capacity_entry.pack(side=tk.LEFT)

        # Commands Input
        cmd_frame = ttk.Frame(main_frame)
        cmd_frame.pack(fill=tk.X, pady=10)
        cmd_label = ttk.Label(cmd_frame, text="Commands (semicolon-separated):", font=("Helvetica", 10, "bold"))
        cmd_label.pack(anchor=tk.W, pady=(0, 5))
        self.commands_entry = ttk.Entry(cmd_frame, width=50)
        self.commands_entry.insert(0, "put 1 1;put 2 2;get 1;put 3 3;get 2;get 3")
        self.commands_entry.pack(fill=tk.X)

        # Run Button
        self.run_button = ttk.Button(main_frame, text="Execute Commands", command=self.execute_and_visualize)
        self.run_button.pack(pady=10)

        # Output Display
        output_label = ttk.Label(main_frame, text="Execution Output (Get Results):", font=("Helvetica", 10, "bold"))
        output_label.pack(anchor=tk.W, pady=(10, 2))
        self.output_text = tk.Text(main_frame, height=2, wrap=tk.WORD, font=("Consolas", 11))
        self.output_text.pack(fill=tk.X, pady=(0, 10))
        self.output_text.config(state=tk.DISABLED)

        # Visual Cache State Display
        state_label = ttk.Label(main_frame, text="Step-by-Step Cache State Evolution:", font=("Helvetica", 10, "bold"))
        state_label.pack(anchor=tk.W, pady=(5, 2))
        
        self.state_text = tk.Text(main_frame, height=10, wrap=tk.WORD, font=("Consolas", 10))
        self.state_text.pack(fill=tk.BOTH, expand=True)
        self.state_text.config(state=tk.DISABLED)

    def execute_and_visualize(self):
        # Validate Capacity
        try:
            capacity = int(self.capacity_entry.get())
            if capacity <= 0:
                raise ValueError()
        except ValueError:
            messagebox.showerror("Invalid Input", "Capacity must be a positive integer.")
            return

        commands_str = self.commands_entry.get()
        commands = [cmd.strip() for cmd in commands_str.split(';') if cmd.strip()]

        # Initialize Cache
        cache = LRUCache(capacity)
        results = []
        steps_log = []

        steps_log.append(f"Initialized LRU Cache with capacity {capacity}\n")

        for cmd in commands:
            parts = cmd.split()
            if not parts:
                continue
            op = parts[0].lower()
            if op == 'put' and len(parts) == 3:
                try:
                    key = int(parts[1])
                    val = int(parts[2])
                    cache.put(key, val)
                    steps_log.append(f"Command: put {key} {val} -> Cache State: {dict(cache.cache)}")
                except ValueError:
                    steps_log.append(f"Command: {cmd} -> Error: Invalid arguments")
            elif op == 'get' and len(parts) == 2:
                try:
                    key = int(parts[1])
                    res = cache.get(key)
                    results.append(str(res))
                    steps_log.append(f"Command: get {key} -> Returned: {res} | Cache State: {dict(cache.cache)}")
                except ValueError:
                    results.append("-1")
                    steps_log.append(f"Command: {cmd} -> Error: Invalid arguments")
            else:
                steps_log.append(f"Command: {cmd} -> Error: Unknown or malformed command")

        # Update Output Text
        self.output_text.config(state=tk.NORMAL)
        self.output_text.delete("1.0", tk.END)
        self.output_text.insert(tk.END, " ".join(results))
        self.output_text.config(state=tk.DISABLED)

        # Update Steps Log Text
        self.state_text.config(state=tk.NORMAL)
        self.state_text.delete("1.0", tk.END)
        self.state_text.insert(tk.END, "\n".join(steps_log))
        self.state_text.config(state=tk.DISABLED)


if __name__ == "__main__":
    # If command line arguments are provided, run in CLI mode
    if len(sys.argv) > 1:
        commands_input = sys.argv[1]
        # Default capacity to 2 if not specified, or dynamically parse if needed.
        # Since the prompt specifies reading commands from sys.argv[1], we run with a default capacity of 2.
        output = run_commands(commands_input, capacity=2)
        print(output)
    else:
        # Otherwise, launch the GUI
        root = tk.Tk()
        app = LRUCacheGUI(root)
        root.mainloop()
```


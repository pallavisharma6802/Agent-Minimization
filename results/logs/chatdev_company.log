```python
'''
This module provides the core logic for evaluating Reverse Polish Notation (RPN) expressions.
It supports basic arithmetic operators (+, -, *, /) with integer division truncating toward zero.
'''
def evaluate_rpn(expression: str) -> int:
    """
    Evaluates a space-separated Reverse Polish Notation (RPN) expression.
    Supports integers and operators: +, -, *, /
    Division truncates toward zero using pure integer arithmetic to avoid float precision issues.
    """
    tokens = expression.strip().split()
    if not tokens:
        raise ValueError("Expression is empty")
    stack = []
    for token in tokens:
        if token in ('+', '-', '*', '/'):
            if len(stack) < 2:
                raise ValueError(f"Invalid RPN expression: insufficient operands for operator '{token}'")
            b = stack.pop()
            a = stack.pop()
            if token == '+':
                stack.append(a + b)
            elif token == '-':
                stack.append(a - b)
            elif token == '*':
                stack.append(a * b)
            elif token == '/':
                if b == 0:
                    raise ZeroDivisionError("Division by zero is undefined")
                # Pure integer division truncating toward zero:
                # If signs differ and there is a remainder, a // b rounds towards negative infinity.
                # We adjust it to round towards zero.
                if (a < 0) ^ (b < 0) and a % b != 0:
                    stack.append((a // b) + 1)
                else:
                    stack.append(a // b)
        else:
            try:
                stack.append(int(token))
            except ValueError:
                raise ValueError(f"Invalid token: '{token}' is neither a valid integer nor a supported operator")
    if len(stack) != 1:
        raise ValueError("Invalid RPN expression: too many operands remaining")
    return stack[0]

'''
This module implements an LRU (Least Recently Used) Cache with both a command-line 
interface (for processing semicolon-separated command strings) and a graphical user 
interface (GUI) built with tkinter for interactive visualization.
'''
import sys
from collections import OrderedDict
import tkinter as tk
from tkinter import messagebox, ttk
class LRUCache:
    '''
    A Least Recently Used (LRU) Cache implemented using collections.OrderedDict.
    All operations (get and put) run in O(1) average time complexity.
    '''
    def __init__(self, capacity: int):
        self.capacity = capacity
        self.cache = OrderedDict()
    def get(self, key: int) -> int:
        if key not in self.cache:
            return -1
        # Move the accessed key to the end to mark it as most recently used
        self.cache.move_to_end(key)
        return self.cache[key]
    def put(self, key: int, value: int) -> None:
        if key in self.cache:
            # Update value and move to the end
            self.cache[key] = value
            self.cache.move_to_end(key)
        else:
            if len(self.cache) >= self.capacity:
                # Pop the first item (least recently used)
                self.cache.popitem(last=False)
            self.cache[key] = value
def parse_and_run_commands(command_str: str, capacity: int = 2) -> str:
    '''
    Parses a semicolon-separated string of commands (e.g., 'put 1 1;get 1')
    and executes them on an LRUCache instance. Returns space-joined results of 'get' calls.
    '''
    cache = LRUCache(capacity)
    results = []
    # Clean and split commands
    commands = [cmd.strip() for cmd in command_str.split(';') if cmd.strip()]
    for cmd in commands:
        parts = cmd.split()
        if not parts:
            continue
        op = parts[0].lower()
        if op == 'put' and len(parts) == 3:
            try:
                key = int(parts[1])
                val = int(parts[2])
                cache.put(key, val)
            except ValueError:
                pass  # Ignore malformed integer arguments
        elif op == 'get' and len(parts) == 2:
            try:
                key = int(parts[1])
                res = cache.get(key)
                results.append(str(res))
            except ValueError:
                results.append("-1")
    return " ".join(results)
class LRUGUI:
    '''
    A Tkinter GUI application to visualize and interact with the LRU Cache.
    '''

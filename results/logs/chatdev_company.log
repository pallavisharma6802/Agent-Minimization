        # Input Frame
        self.input_frame = tk.Frame(root)
        self.input_frame.pack(pady=10)
        
        self.label = tk.Label(self.input_frame, text="Enter positive integer (n):", font=("Helvetica", 11))
        self.label.pack(side=tk.LEFT, padx=5)
        
        self.entry = tk.Entry(self.input_frame, width=10, font=("Helvetica", 11))
        self.entry.pack(side=tk.LEFT, padx=5)
        self.entry.focus()
        
        # Calculate Button
        self.calc_button = tk.Button(
            root, 
            text="Find Prime", 
            command=self.calculate_prime, 
            font=("Helvetica", 11, "bold"),
            bg="#4CAF50",
            fg="white",
            activebackground="#45a049",
            activeforeground="white"
        )
        self.calc_button.pack(pady=10)
        
        # Result Label
        self.result_label = tk.Label(
            root, 
            text="", 
            font=("Helvetica", 12, "italic"),
            fg="#333333"
        )
        self.result_label.pack(pady=10)

    def calculate_prime(self):
        '''Handles the button click, validates input, and displays the result.'''
        input_val = self.entry.get().strip()
        if not input_val:
            messagebox.showerror("Input Error", "Please enter an integer value.")
            return
        
        try:
            n = int(input_val)
            if n <= 0:
                raise ValueError
        except ValueError:
            messagebox.showerror("Input Error", "Please enter a valid positive integer (n >= 1).")
            return
        
        try:
            # Show a temporary calculating status for larger numbers
            self.result_label.config(text="Calculating...", fg="blue")
            self.root.update_idletasks()
            
            prime = find_nth_prime(n)
            self.result_label.config(
                text=f"The {n}-th prime number is: {prime}", 
                fg="green"
            )
        except Exception as e:
            messagebox.showerror("Error", f"An error occurred: {str(e)}")
            self.result_label.config(text="")

def main():
    '''Entry point of the application.'''
    # If command-line arguments are provided, run in CLI mode
    if len(sys.argv) > 1:
        try:
            n = int(sys.argv[1])
            if n < 1:
                print("Error: The input must be a positive integer (>= 1).", file=sys.stderr)
                sys.exit(1)
            result = find_nth_prime(n)
            print(result)
            sys.exit(0)
        except ValueError:
            print("Error: Please provide a valid positive integer as an argument.", file=sys.stderr)
            sys.exit(1)
    else:
        # If no arguments are provided, launch the GUI
        root = tk.Tk()
        app = PrimeApp(root)
        root.mainloop()

if __name__ == "__main__":
    main()

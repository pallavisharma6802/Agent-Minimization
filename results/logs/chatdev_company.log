### Implementation

Here is the complete code for the application.

#### `main.py`

```python
'''
This is the entry point of the Roman Numeral Converter application.
It supports both command-line execution (via sys.argv[1]) and a graphical user interface (GUI) if no arguments are provided.
'''

import sys
import tkinter as tk
from tkinter import messagebox

class RomanConverter:
    """Utility class to handle Roman numeral conversions and validations."""
    
    ROMAN_MAP = {
        'I': 1,
        'V': 5,
        'X': 10,
        'L': 50,
        'C': 100,
        'D': 500,
        'M': 1000
    }

    @staticmethod
    def to_integer(roman: str) -> int:
        """
        Converts a Roman numeral string to its corresponding integer value.
        Handles standard subtractive forms (IV=4, IX=9, XL=40, XC=90, CD=400, CM=900).
        Raises ValueError if the input contains invalid characters or is empty.
        """
        roman = roman.upper().strip()
        if not roman:
            raise ValueError("Input cannot be empty.")

        # Validate characters
        for char in roman:
            if char not in RomanConverter.ROMAN_MAP:
                raise ValueError(f"Invalid Roman numeral character: '{char}'")

        total = 0
        prev_value = 0
        
        # Process from right to left to easily handle subtractive forms
        for char in reversed(roman):
            current_value = RomanConverter.ROMAN_MAP[char]
            if current_value < prev_value:
                total -= current_value
            else:
                total += current_value
            prev_value = current_value

        return total


class RomanConverterGUI:
    """Graphical User Interface for the Roman Numeral Converter."""
    
    def __init__(self, root):
        self.root = root
        self.root.title("Roman Numeral Converter")
        self.root.geometry("450x300")
        self.root.resizable(False, False)
        self.root.configure(bg="#f4f4f9")

        # Title Label
        self.title_label = tk.Label(
            root, 
            text="Roman Numeral Converter", 
            font=("Helvetica", 16, "bold"), 
            bg="#f4f4f9", 
            fg="#2c3e50"
        )
        self.title_label.pack(pady=15)

        # Input Frame
        self.input_frame = tk.Frame(root, bg="#f4f4f9")
        self.input_frame.pack(pady=10)

        self.entry_label = tk.Label(
            self.input_frame, 
            text="Enter Roman Numeral:", 
            font=("Helvetica", 11), 
            bg="#f4f4f9", 
            fg="#34495e"
        )
        self.entry_label.grid(row=0, column=0, padx=5)

        self.roman_entry = tk.Entry(
            self.input_frame, 
            font=("Helvetica", 12), 
            width=15, 
            justify="center"
        )
        self.roman_entry.grid(row=0, column=1, padx=5)
        self.roman_entry.focus()
        self.roman_entry.bind("<Return>", lambda event: self.convert())

        # Convert Button
        self.convert_button = tk.Button(
            root, 
            text="Convert", 
            font=("Helvetica", 11, "bold"), 
            bg="#3498db", 
            fg="white", 
            activebackground="#2980b9", 
            activeforeground="white", 
            command=self.convert,
            width=12
        )
        self.convert_button.pack(pady=10)

        # Result Label
        self.result_label = tk.Label(
            root, 
            text="Integer Value: -", 
            font=("Helvetica", 14, "bold"), 
            bg="#f4f4f9", 
            fg="#27ae60"
        )
        self.result_label.pack(pady=15)

        # Footer Info
        self.footer_label = tk.Label(
            root, 
            text="Supports subtractive forms (e.g., IV, IX, XL, XC, CD, CM)", 
            font=("Helvetica", 9, "italic"), 
            bg="#f4f4f9", 
            fg="#7f8c8d"
        )
        self.footer_label.pack(side="bottom", pady=10)

    def convert(self):
        """Triggered by the convert button or Enter key to perform conversion and update GUI."""
        input_text = self.roman_entry.get()
        try:
            result = RomanConverter.to_integer(input_text)
            self.result_label.config(text=f"Integer Value: {result}", fg="#27ae60")
        except ValueError as e:
            messagebox.showerror("Invalid Input", str(e))
            self.result_label.config(text="Integer Value: -", fg="#c0392b")


def main():
    # If a command-line argument is provided, run in CLI mode
    if len(sys.argv) > 1:
        roman_input = sys.argv[1]
        try:
            integer_value = RomanConverter.to_integer(roman_input)
            print(integer_value)
            sys.exit(0)
        except ValueError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
    else:
        # Otherwise, launch the GUI
        root = tk.Tk()
        app = RomanConverterGUI(root)
        root.mainloop()


if __name__ == "__main__":
    main()
```


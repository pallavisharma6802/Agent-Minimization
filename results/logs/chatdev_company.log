+        self.file_label.config(text=os.path.basename(filepath), fg="black")
+        try:
+            word_count = count_words(filepath)
+            self.result_label.config(text=f"Word Count: {word_count}", fg="green")
+            # Load preview of the file
+            with open(filepath, 'r', encoding='utf-8', errors='replace') as file:
+                preview_content = file.read(2000)  # Read up to 2000 characters for preview
+            self.text_preview.delete("1.0", tk.END)
+            self.text_preview.insert(tk.END, preview_content)
+            if len(preview_content) >= 2000:
+                self.text_preview.insert(tk.END, "\n... [Truncated Preview] ...")
+        except Exception as e:
+            messagebox.showerror("Error", f"Could not read file:\n{e}")
+            self.result_label.config(text="Word Count: Error", fg="red")
+            self.text_preview.delete("1.0", tk.END)
+if __name__ == "__main__":
+    # If a command-line argument is provided, run in CLI mode
+    if len(sys.argv) > 1:
+        run_cli(sys.argv[1])
+    # Otherwise, launch the GUI
+    else:
+        root = tk.Tk()
+        app = WordCounterGUI(root)
+        root.mainloop()

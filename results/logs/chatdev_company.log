        input_frame.pack(pady=10, fill=tk.X, padx=20)
        input_label = tk.Label(
            input_frame, 
            text="Enter Edges (e.g., a>b,a>c,b>d,c>d):", 
            font=("Helvetica", 11), 
            bg="#f0f0f0"
        )
        input_label.pack(anchor=tk.W, pady=2)
        self.entry = tk.Entry(input_frame, font=("Courier", 12), bd=2, relief=tk.GROOVE)
        self.entry.pack(fill=tk.X, ipady=4)
        self.entry.insert(0, "a>b,a>c,b>d,c>d")
        # Button Frame
        btn_frame = tk.Frame(root, bg="#f0f0f0")
        btn_frame.pack(pady=15)
        solve_btn = tk.Button(
            btn_frame, 
            text="Solve Topological Order", 
            command=self.solve, 
            font=("Helvetica", 11, "bold"), 
            bg="#4CAF50", 
            fg="white", 
            activebackground="#45a049", 
            relief=tk.RAISED, 
            padx=10, 
            pady=5
        )
        solve_btn.pack(side=tk.LEFT, padx=10)
        clear_btn = tk.Button(
            btn_frame, 
            text="Clear", 
            command=self.clear, 
            font=("Helvetica", 11), 
            bg="#f44336", 
            fg="white", 
            activebackground="#da190b", 
            relief=tk.RAISED, 
            padx=10, 
            pady=5
        )
        clear_btn.pack(side=tk.LEFT, padx=10)
        # Output Frame
        output_frame = tk.Frame(root, bg="#f0f0f0")
        output_frame.pack(pady=10, fill=tk.BOTH, expand=True, padx=20)
        output_label = tk.Label(
            output_frame, 
            text="Result:", 
            font=("Helvetica", 11, "bold"), 
            bg="#f0f0f0"
        )
        output_label.pack(anchor=tk.W)
        self.result_text = tk.Text(
            output_frame, 
            height=5, 
            font=("Courier", 14, "bold"), 
            bd=2, 
            relief=tk.SUNKEN, 
            wrap=tk.WORD
        )
        self.result_text.pack(fill=tk.BOTH, expand=True, pady=5)
        self.result_text.config(state=tk.DISABLED)
    def solve(self):
        edge_str = self.entry.get()
        adj, in_degree, all_nodes = parse_graph(edge_str)
        if not all_nodes:
            self.display_result("Empty Graph")
            return
        order, has_cycle = topological_sort(adj, in_degree, all_nodes)
        if has_cycle:
            self.display_result("CYCLE", is_error=True)
        else:
            self.display_result(" ".join(order))
    def display_result(self, text, is_error=False):
        self.result_text.config(state=tk.NORMAL)
        self.result_text.delete("1.0", tk.END)
        self.result_text.insert(tk.END, text)
        if is_error:
            self.result_text.config(fg="red")
        else:
            self.result_text.config(fg="green")
        self.result_text.config(state=tk.DISABLED)
    def clear(self):
        self.entry.delete(0, tk.END)
        self.result_text.config(state=tk.NORMAL)
        self.result_text.delete("1.0", tk.END)
        self.result_text.config(state=tk.DISABLED)
def main():
    # If command line argument is provided, run in CLI mode
    if len(sys.argv) > 1:
        edge_str = sys.argv[1]
        adj, in_degree, all_nodes = parse_graph(edge_str)
        order, has_cycle = topological_sort(adj, in_degree, all_nodes)
        if has_cycle:
            print("CYCLE")
        else:
            print(" ".join(order))
    else:
        # Otherwise, launch the GUI application
        root = tk.Tk()
        app = GraphApp(root)
        root.mainloop()
if __name__ == "__main__":
    main()

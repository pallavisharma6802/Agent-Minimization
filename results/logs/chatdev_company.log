'''
This module provides a bracket balance checker. It can be run in two modes:
1. CLI Mode: If a string argument is passed via command line (sys.argv[1]), 
   it prints 'True' or 'False' and exits.
2. GUI Mode: If no arguments are passed, it launches a Tkinter graphical interface 
   where users can interactively check strings.
'''
import sys
import tkinter as tk
def is_balanced(s: str) -> bool:
    """
    Checks if all (), [], {} brackets in the string are balanced and correctly nested.
    All non-bracket characters are ignored.
    """
    stack = []
    # Mapping of closing brackets to their corresponding opening brackets
    bracket_map = {')': '(', ']': '[', '}': '{'}
    opening_brackets = set(bracket_map.values())
    closing_brackets = set(bracket_map.keys())
    for char in s:
        if char in opening_brackets:
            stack.append(char)
        elif char in closing_brackets:
            if not stack or stack[-1] != bracket_map[char]:
                return False
            stack.pop()
    return len(stack) == 0
class BracketCheckerGUI:
    """
    A Tkinter GUI application for checking bracket balance.
    """
    def __init__(self, root: tk.Tk):
        self.root = root
        self.root.title("Bracket Balance Checker")
        self.root.geometry("450x220")
        self.root.resizable(False, False)
        # Title Label
        self.title_label = tk.Label(
            root, 
            text="Bracket Balance Checker", 
            font=("Helvetica", 16, "bold")
        )
        self.title_label.pack(pady=10)
        # Instruction Label
        self.instruction_label = tk.Label(
            root, 
            text="Enter text containing brackets (), [], {}:", 
            font=("Helvetica", 10)
        )
        self.instruction_label.pack(pady=2)
        # Input Entry
        self.entry = tk.Entry(root, width=45, font=("Helvetica", 11))
        self.entry.pack(pady=5)
        self.entry.focus_set()
        # Bind Enter key to trigger the check
        self.entry.bind("<Return>", lambda event: self.check_brackets())
        # Check Button
        self.check_button = tk.Button(
            root, 
            text="Check Balance", 
            command=self.check_brackets, 
            font=("Helvetica", 10, "bold"),
            bg="#2196F3", 
            fg="white",
            activebackground="#1976D2",
            activeforeground="white"
        )
        self.check_button.pack(pady=10)
        # Result Label
        self.result_label = tk.Label(
            root, 
            text="", 
            font=("Helvetica", 12, "bold")
        )
        self.result_label.pack(pady=5)
    def check_brackets(self):
        """
        Retrieves text from the entry widget, checks its balance, 
        and updates the result label.
        """
        text = self.entry.get()
        balanced = is_balanced(text)
        if balanced:
            self.result_label.config(text="Result: True (Balanced)", fg="#4CAF50")
        else:
            self.result_label.config(text="Result: False (Unbalanced)", fg="#F44336")
if __name__ == "__main__":
    # If an argument is provided via command line, run in CLI mode
    if len(sys.argv) > 1:
        input_string = sys.argv[1]
        print(is_balanced(input_string))
    else:
        # Otherwise, launch the GUI
        root = tk.Tk()
        app = BracketCheckerGUI(root)
        root.mainloop()
```


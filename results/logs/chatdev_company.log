"main.py
```python
'''
This module provides a dual-mode Word Counter application.
If a filename is passed as a command-line argument (sys.argv[1]), it prints the word count to stdout.
If no argument is provided, it launches a graphical user interface (GUI) using tkinter.
'''
import sys
import os
from tkinter import Tk, Label, Button, Text, Scrollbar, filedialog, messagebox, END, BOTH, RIGHT, Y, LEFT
def count_words(filepath):
    '''
    Reads a file and returns the number of words separated by whitespace.
    Raises FileNotFoundError or PermissionError if the file cannot be accessed.
    '''
    with open(filepath, 'r', encoding='utf-8', errors='ignore') as file:
        content = file.read()
        words = content.split()
        return len(words)
def run_cli(filepath):
    '''
    Executes the command-line interface logic.
    Prints the word count to stdout or an error message to stderr.
    '''
    if not os.path.exists(filepath):
        print(f"Error: File '{filepath}' does not exist.", file=sys.stderr)
        sys.exit(1)
    try:
        word_count = count_words(filepath)
        print(word_count)
        sys.exit(0)
    except Exception as e:
        print(f"Error reading file: {e}", file=sys.stderr)
        sys.exit(1)
class WordCounterGUI:
    '''
    A Tkinter GUI wrapper for the Word Counter application.
    '''
    def __init__(self, root):
        self.root = root
        self.root.title("Word Counter")
        self.root.geometry("600x400")
        self.root.minsize(400, 300)
        # Title Label
        self.title_label = Label(root, text="Word Counter Tool", font=("Helvetica", 16, "bold"))
        self.title_label.pack(pady=10)
        # File Selection Button
        self.select_button = Button(root, text="Select File", command=self.select_file, font=("Helvetica", 12))
        self.select_button.pack(pady=5)
        # File Path Label
        self.file_label = Label(root, text="No file selected", font=("Helvetica", 10, "italic"), fg="gray")
        self.file_label.pack(pady=5)
        # Result Label
        self.result_label = Label(root, text="Word Count: 0", font=("Helvetica", 14, "bold"), fg="green")
        self.result_label.pack(pady=10)
        # Text Preview Label
        self.preview_label = Label(root, text="File Preview:", font=("Helvetica", 10, "bold"))
        self.preview_label.pack(anchor="w", padx=20)
        # Text Area with Scrollbar for Preview
        self.text_frame = Label(root)
        self.text_frame.pack(fill=BOTH, expand=True, padx=20, pady=10)
        self.scrollbar = Scrollbar(self.text_frame)
        self.scrollbar.pack(side=RIGHT, fill=Y)
        self.text_area = Text(self.text_frame, yscrollcommand=self.scrollbar.set, wrap="word", font=("Courier New", 10))
        self.text_area.pack(side=LEFT, fill=BOTH, expand=True)
        self.scrollbar.config(command=self.text_area.yview)
    def select_file(self):
        '''
        Opens a file dialog, counts the words in the selected file,
        and updates the GUI with the results and file preview.
        '''
        filepath = filedialog.askopenfilename(
            title="Select Text File",
            filetypes=[("Text Files", "*.txt"), ("All Files", "*.*")]
        )
        if not filepath:
            return
        self.file_label.config(text=os.path.basename(filepath), fg="black")
        try:
            word_count = count_words(filepath)
            self.result_label.config(text=f"Word Count: {word_count}", fg="green")
            # Load preview
            with open(filepath, 'r', encoding='utf-8', errors='ignore') as file:
                preview_content = file.read(5000)  # Limit preview to first 5000 characters
                if len(preview_content) >= 5000:
                    preview_content += "\n\n[... Content truncated for preview ...]"
            self.text_area.delete("1.0", END)
            self.text_area.insert(END, preview_content)
        except Exception as e:
            messagebox.showerror("Error", f"Could not read file:\n{str(e)}")
            self.result_label.config(text="Word Count: Error", fg="red")
            self.text_area.delete("1.0", END)
def main():
    '''
    Main entry point. Decides between CLI and GUI mode based on sys.argv.
    '''
    if len(sys.argv) > 1:
        # CLI Mode
        run_cli(sys.argv[1])
    else:
        # GUI Mode
        root = Tk()
        app = WordCounterGUI(root)
        root.mainloop()
if __name__ == "__main__":
    main()

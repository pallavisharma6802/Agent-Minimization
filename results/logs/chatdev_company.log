This module implements a topological sorting tool for Directed Acyclic Graphs (DAGs).
It reads a graph representation from command-line arguments or launches a GUI if no arguments are provided.
It outputs the lexicographically smallest topological order or 'CYCLE' if a cycle is detected.
'''

import sys
import heapq
import tkinter as tk
from tkinter import messagebox, ttk

class TopologicalSorter:
    """
    Handles parsing of the graph representation and executing Kahn's algorithm
    for topological sorting with lexicographical tie-breaking.
    """
    def __init__(self, edge_string: str):
        self.edge_string = edge_string
        self.adj = {}
        self.in_degree = {}
        self.nodes = set()

    def parse_graph(self) -> bool:
        """
        Parses the edge string (e.g., 'a>b,a>c') and builds the adjacency list and in-degree map.
        Returns True if parsing is successful, False otherwise.
        """
        if not self.edge_string.strip():
            return False
        
        # Split by comma to get individual edges
        edges = [e.strip() for e in self.edge_string.split(',') if e.strip()]
        
        for edge in edges:
            if '>' not in edge:
                # Handle isolated nodes if any, or invalid formats
                node = edge.strip()
                if node:
                    self.nodes.add(node)
                    if node not in self.adj:
                        self.adj[node] = []
                    if node not in self.in_degree:
                        self.in_degree[node] = 0
                continue
            
            parts = edge.split('>')
            if len(parts) != 2:
                return False
            
            u, v = parts[0].strip(), parts[1].strip()
            if not u or not v:
                return False
            
            self.nodes.add(u)
            self.nodes.add(v)
            
            if u not in self.adj:
                self.adj[u] = []
            if v not in self.adj:
                self.adj[v] = []
                
            self.adj[u].append(v)
            
            if u not in self.in_degree:
                self.in_degree[u] = 0
            if v not in self.in_degree:
                self.in_degree[v] = 0
                
            self.in_degree[v] += 1
            
        return len(self.nodes) > 0

    def sort(self) -> str:
        """
        Executes Kahn's algorithm using a min-heap to ensure lexicographical order for tie-breaking.
        Returns a space-separated topological order or 'CYCLE'.
        """
        if not self.parse_graph():
            return "Invalid Input"

        # Initialize min-heap with all nodes having in-degree 0
        heap = [node for node in self.nodes if self.in_degree[node] == 0]
        heapq.heapify(heap)
        
        order = []
        
        while heap:
            # Pop the lexicographically smallest node
            u = heapq.heappop(heap)
            order.append(u)
            
            for v in self.adj[u]:
                self.in_degree[v] -= 1
                if self.in_degree[v] == 0:
                    heapq.heappush(heap, v)
                    
        if len(order) == len(self.nodes):
            return " ".join(order)
        else:
            return "CYCLE"



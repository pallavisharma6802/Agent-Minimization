'''
This module implements an LRU (Least Recently Used) Cache with both a command-line 
interface (for processing semicolon-separated command strings) and a graphical user 
interface (GUI) built with tkinter for interactive visualization.
'''
import sys
from collections import OrderedDict
import tkinter as tk
from tkinter import messagebox, ttk

class LRUCache:
    '''
    A Least Recently Used (LRU) Cache implemented using collections.OrderedDict.
    All operations (get and put) run in O(1) average time complexity.
    '''
    def __init__(self, capacity: int):
        self.capacity = capacity
        self.cache = OrderedDict()

    def get(self, key: int) -> int:
        if key not in self.cache:
            return -1
        # Move the accessed key to the end to mark it as most recently used
        self.cache.move_to_end(key)
        return self.cache[key]

    def put(self, key: int, value: int) -> None:
        if key in self.cache:
            # Update value and move to the end
            self.cache[key] = value
            self.cache.move_to_end(key)
        else:
            if len(self.cache) >= self.capacity:
                # Pop the first item (least recently used)
                self.cache.popitem(last=False)
            self.cache[key] = value

def parse_and_run_commands(command_str: str, capacity: int = 2) -> str:
    '''
    Parses a semicolon-separated string of commands (e.g., 'put 1 1;get 1')
    and executes them on an LRUCache instance. Returns space-joined results of 'get' calls.
    '''
    cache = LRUCache(capacity)
    results = []
    # Clean and split commands
    commands = [cmd.strip() for cmd in command_str.split(';') if cmd.strip()]
    for cmd in commands:
        parts = cmd.split()
        if not parts:
            continue
        op = parts[0].lower()
        if op == 'put' and len(parts) == 3:
            try:
                key = int(parts[1])
                val = int(parts[2])
                cache.put(key, val)
            except ValueError:
                pass  # Ignore malformed integer arguments
        elif op == 'get' and len(parts) == 2:
            try:
                key = int(parts[1])
                res = cache.get(key)
                results.append(str(res))
            except ValueError:
                results.append("-1")
    return " ".join(results)

class LRUGUI:
    '''
    A Tkinter GUI application to visualize and interact with the LRU Cache.
    '''
    def __init__(self, root):
        self.root = root
        self.root.title("LRU Cache Visualizer")
        self.root.geometry("600x500")
        self.root.resizable(False, False)
        # Default cache initialization
        self.capacity = 3
        self.cache = LRUCache(self.capacity)
        self._create_widgets()
        self._update_visualization()

    def _create_widgets(self):
        # Title / Header
        header = tk.Label(self.root, text="LRU Cache Visualizer", font=("Helvetica", 16, "bold"))
        header.pack(pady=10)

        # Capacity Configuration Frame
        cap_frame = tk.LabelFrame(self.root, text="Configuration", padx=10, pady=5)
        cap_frame.pack(fill="x", padx=15, pady=5)
        tk.Label(cap_frame, text="Cache Capacity:").pack(side="left", padx=5)
        self.cap_entry = tk.Entry(cap_frame, width=5)
        self.cap_entry.insert(0, str(self.capacity))
        self.cap_entry.pack(side="left", padx=5)
        set_cap_btn = tk.Button(cap_frame, text="Initialize/Reset Cache", command=self._reset_cache)
        set_cap_btn.pack(side="left", padx=10)

        # Operations Frame
        ops_frame = tk.LabelFrame(self.root, text="Operations", padx=10, pady=10)
        ops_frame.pack(fill="x", padx=15, pady=5)

        # Put Operation
        put_subframe = tk.Frame(ops_frame)
        put_subframe.pack(fill="x", pady=2)
        tk.Label(put_subframe, text="Put Key:", width=8, anchor="w").pack(side="left")
        self.put_key_entry = tk.Entry(put_subframe, width=8)
        self.put_key_entry.pack(side="left", padx=5)
        tk.Label(put_subframe, text="Value:").pack(side="left")
        self.put_val_entry = tk.Entry(put_subframe, width=8)
        self.put_val_entry.pack(side="left", padx=5)
        put_btn = tk.Button(put_subframe, text="Execute Put", command=self._execute_put, width=12)
        put_btn.pack(side="left", padx=10)

        # Get Operation
        get_subframe = tk.Frame(ops_frame)
        get_subframe.pack(fill="x", pady=2)
        tk.Label(get_subframe, text="Get Key:", width=8, anchor="w").pack(side="left")
        self.get_key_entry = tk.Entry(get_subframe, width=8)
        self.get_key_entry.pack(side="left", padx=5)
        get_btn = tk.Button(get_subframe, text="Execute Get", command=self._execute_get, width=12)
        get_btn.pack(side="left", padx=10)
        self.get_result_label = tk.Label(get_subframe, text="Result: -", font=("Helvetica", 10, "bold"), fg="blue")
        self.get_result_label.pack(side="left", padx=10)

        # Batch Command Frame
        batch_frame = tk.LabelFrame(self.root, text="Batch Command Execution", padx=10, pady=5)
        batch_frame.pack(fill="x", padx=15, pady=5)
        tk.Label(batch_frame, text="Commands:").pack(side="left")
        self.batch_entry = tk.Entry(batch_frame, width=40)
        self.batch_entry.insert(0, "put 1 1;put 2 2;get 1;put 3 3;get 2;get 3")
        self.batch_entry.pack(side="left", padx=5, fill="x", expand=True)
        run_batch_btn = tk.Button(batch_frame, text="Run Batch", command=self._execute_batch)
        run_batch_btn.pack(side="left", padx=5)

        # Visualization Frame
        vis_frame = tk.LabelFrame(self.root, text="Cache State (LRU -> MRU)", padx=10, pady=10)
        vis_frame.pack(fill="both", expand=True, padx=15, pady=10)
        self.canvas = tk.Canvas(vis_frame, bg="white", height=80)
        self.canvas.pack(fill="both", expand=True)

    def _reset_cache(self):
        try:
            cap = int(self.cap_entry.get())
            if cap <= 0:
                raise ValueError
            self.capacity = cap
            self.cache = LRUCache(self.capacity)
            self._update_visualization()
            messagebox.showinfo("Success", f"Cache reinitialized with capacity {self.capacity}")
        except ValueError:
            messagebox.showerror("Error", "Capacity must be a positive integer.")

    def _execute_put(self):
        try:
            key = int(self.put_key_entry.get())
            val = int(self.put_val_entry.get())
            self.cache.put(key, val)
            self._update_visualization()
            self.put_key_entry.delete(0, tk.END)
            self.put_val_entry.delete(0, tk.END)
        except ValueError:
            messagebox.showerror("Error", "Key and Value must be integers.")

    def _execute_get(self):
        try:
            key = int(self.get_key_entry.get())
            res = self.cache.get(key)
            self.get_result_label.config(text=f"Result: {res}")
            self._update_visualization()
            self.get_key_entry.delete(0, tk.END)
        except ValueError:
            messagebox.showerror("Error", "Key must be an integer.")

    def _execute_batch(self):
        cmd_str = self.batch_entry.get()
        if not cmd_str:
            return
        results = parse_and_run_commands(cmd_str, self.capacity)
        messagebox.showinfo("Batch Results", f"Get Results:\n{results}")
        # Sync GUI cache state with the batch execution result by rebuilding it
        self.cache = LRUCache(self.capacity)
        commands = [cmd.strip() for cmd in cmd_str.split(';') if cmd.strip()]
        for cmd in commands:
            parts = cmd.split()
            if len(parts) == 3 and parts[0].lower() == 'put':
                try:
                    self.cache.put(int(parts[1]), int(parts[2]))
                except ValueError:
                    pass
            elif len(parts) == 2 and parts[0].lower() == 'get':
                try:
                    self.cache.get(int(parts[1]))
                except ValueError:
                    pass
        self._update_visualization()

    def _update_visualization(self):
        self.canvas.delete("all")
        items = list(self.cache.cache.items())
        if not items:
            self.canvas.create_text(270, 40, text="Cache is Empty", font=("Helvetica", 12, "italic"), fill="gray")
            return
        box_width = 80
        box_height = 50
        start_x = 20
        y = 15
        spacing = 20
        for i, (k, v) in enumerate(items):
            x1 = start_x + i * (box_width + spacing)
            y1 = y
            x2 = x1 + box_width
            y2 = y1 + box_height
            # Highlight the MRU (Most Recently Used) item with a different color
            color = "#add8e6" if i < len(items) - 1 else "#90ee90"
            self.canvas.create_rectangle(x1, y1, x2, y2, fill=color, outline="black", width=2)
            self.canvas.create_text((x1 + x2) / 2, (y1 + y2) / 2, text=f"K: {k}\nV: {v}", font=("Helvetica", 10, "bold"))
            # Draw order indicators
            if i == 0:
                self.canvas.create_text((x1 + x2) / 2, y2 + 10, text="LRU", font=("Helvetica", 8, "italic"))
            if i == len(items) - 1:
                self.canvas.create_text((x1 + x2) / 2, y2 + 10, text="MRU", font=("Helvetica", 8, "italic"))

if __name__ == "__main__":
    # If command-line arguments are provided, run in CLI mode as requested
    if len(sys.argv) > 1:
        command_input = sys.argv[1]
        # Default capacity is set to 2 as per standard LRU Cache test cases unless specified
        output = parse_and_run_commands(command_input, capacity=2)
        print(output)
    else:
        # Otherwise, launch the interactive GUI
        root = tk.Tk()
        app = LRUGUI(root)
        root.mainloop()

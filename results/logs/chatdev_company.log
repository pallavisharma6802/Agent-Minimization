import tkinter as tk
from tkinter import messagebox
from rpn_evaluator import evaluate_rpn
class RPNApp:
    """
    A Tkinter GUI application for interactive RPN expression evaluation.
    """
    def __init__(self, root):
        self.root = root
        self.root.title("RPN Expression Evaluator")
        self.root.geometry("450x300")
        self.root.resizable(False, False)
        # Title Label
        self.title_label = tk.Label(
            root, 
            text="Reverse Polish Notation Evaluator", 
            font=("Helvetica", 16, "bold")
        )
        self.title_label.pack(pady=15)
        # Instruction Label
        self.instruction_label = tk.Label(
            root, 
            text="Enter space-separated tokens (e.g., '4 13 5 / +'):", 
            font=("Helvetica", 10)
        )
        self.instruction_label.pack(pady=5)
        # Input Entry
        self.entry = tk.Entry(root, font=("Courier New", 12), width=35)
        self.entry.pack(pady=5)
        self.entry.focus()
        # Evaluate Button
        self.eval_button = tk.Button(
            root, 
            text="Evaluate", 
            command=self.perform_evaluation, 
            font=("Helvetica", 11, "bold"),
            bg="#4CAF50",
            fg="white",
            padx=10,
            pady=5
        )
        self.eval_button.pack(pady=15)
        # Result Display Frame
        self.result_frame = tk.Frame(root)
        self.result_frame.pack(pady=10)
        self.result_label_title = tk.Label(
            self.result_frame, 
            text="Result: ", 
            font=("Helvetica", 12, "bold")
        )
        self.result_label_title.pack(side=tk.LEFT)
        self.result_val_label = tk.Label(
            self.result_frame, 
            text="", 
            font=("Courier New", 14, "bold"),
            fg="blue"
        )
        self.result_val_label.pack(side=tk.LEFT)
    def perform_evaluation(self):
        """
        Retrieves the expression from the entry field, evaluates it, and displays the result.
        """
        expression = self.entry.get()
        if not expression.strip():
            messagebox.showwarning("Empty Input", "Please enter an RPN expression.")
            return
        try:
            result = evaluate_rpn(expression)
            self.result_val_label.config(text=str(result), fg="green")
        except Exception as e:
            self.result_val_label.config(text="Error", fg="red")
            messagebox.showerror("Evaluation Error", str(e))
def run_gui():
    """
    Initializes and starts the Tkinter main loop.
    """
    root = tk.Tk()
    app = RPNApp(root)
    root.mainloop()

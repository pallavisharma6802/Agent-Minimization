            padx=10, 
            pady=5
        )
        clear_btn.pack(side=tk.LEFT, padx=10)
        # Output Frame
        output_frame = tk.Frame(root, bg="#f0f0f0")
        output_frame.pack(pady=10, fill=tk.BOTH, expand=True, padx=20)
        output_label = tk.Label(
            output_frame, 

```python
'''
This module provides the RomanConverter class, which handles the conversion
of Roman numeral strings to their corresponding integer values.
'''
class RomanConverter:
    @staticmethod
    def roman_to_int(roman_str: str) -> int:
        '''
        Converts a Roman numeral string to an integer.
        Handles standard subtractive forms (IV=4, IX=9, XL=40, XC=90, CD=400, CM=900).
        Raises ValueError if the input contains invalid characters or is empty.
        '''
        roman_map = {
            'I': 1,
            'V': 5,
            'X': 10,
            'L': 50,
            'C': 100,
            'D': 500,
            'M': 1000
        }
        # Normalize input to uppercase and strip whitespace
        s = roman_str.strip().upper()
        if not s:
            raise ValueError("Input string is empty.")
        # Validate characters
        for char in s:
            if char not in roman_map:
                raise ValueError(f"Invalid Roman numeral character: '{char}'")
        total = 0
        prev_value = 0
        # Process from right to left to easily handle subtractive forms
        for char in reversed(s):
            current_value = roman_map[char]
            if current_value < prev_value:
                total -= current_value
            else:
                total += current_value
            prev_value = current_value
        return total

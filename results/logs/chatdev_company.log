            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
    else:
        # Otherwise, launch the GUI
        root = tk.Tk()
        app = RomanGUI(root)
        root.mainloop()
if __name__ == "__main__":
    main()

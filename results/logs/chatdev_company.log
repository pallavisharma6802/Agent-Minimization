from tkinter import messagebox
from tkinter import scrolledtext
from fizzbuzz import generate_fizzbuzz_sequence

class FizzBuzzGUI:
    def __init__(self, root):
        self.root = root
        self.root.title("FizzBuzz Generator")
        self.root.geometry("450x500")
        self.root.minsize(400, 400)
        
        self.create_widgets()

    def create_widgets(self):
        # Header Label
        header_label = tk.Label(self.root, text="FizzBuzz Sequence Generator", font=("Arial", 16, "bold"))
        header_label.pack(pady=15)

        # Input Frame
        input_frame = tk.Frame(self.root)
        input_frame.pack(pady=10)

        input_label = tk.Label(input_frame, text="Enter N:", font=("Arial", 12))
        input_label.pack(side=tk.LEFT, px=5)

        self.entry_n = tk.Entry(input_frame, font=("Arial", 12), width=10)
        self.entry_n.pack(side=tk.LEFT, px=5)
        self.entry_n.focus()

        # Generate Button
        generate_btn = tk.Button(self.root, text="Generate", font=("Arial", 12, "bold"), bg="#4CAF50", fg="white", command=self.on_generate)
        generate_btn.pack(pady=10)

        # Output Area
        output_label = tk.Label(self.root, text="Results:", font=("Arial", 11, "bold"))
        output_label.pack(anchor="w", px=20, pady=(10, 2))

        self.output_text = scrolledtext.ScrolledText(self.root, font=("Consolas", 11), wrap=tk.WORD)
        self.output_text.pack(fill=tk.BOTH, expand=True, px=20, pady=(0, 20))

    def on_generate(self):
        input_val = self.entry_n.get().strip()
        if not input_val:
            messagebox.showerror("Input Error", "Please enter an integer value.")
            return

        try:
            n = int(input_val)
            if n < 1:
                messagebox.showerror("Input Error", "Please enter an integer greater than or equal to 1.")
                return
        except ValueError:
            messagebox.showerror("Input Error", "Invalid input. Please enter a valid integer.")
            return

        # Generate sequence and display
        sequence = generate_fizzbuzz_sequence(n)
        
        self.output_text.delete("1.0", tk.END)
        self.output_text.insert(tk.END, "\n".join(sequence))

'''
This module reads a directed graph from command-line arguments or a GUI,
performs a lexicographical topological sort, and handles cycle detection.
'''
import sys
import heapq
import tkinter as tk
from tkinter import messagebox
def parse_graph(edge_str):
    """
    Parses an edge string like 'a>b,a>c' into:
    - adj: adjacency list mapping node -> list of neighbors
    - in_degree: dictionary mapping node -> in-degree count
    - all_nodes: set of all unique nodes in the graph
    """
    adj = {}
    in_degree = {}
    all_nodes = set()
    if not edge_str.strip():
        return adj, in_degree, all_nodes
    edges = edge_str.split(',')
    for edge in edges:
        edge = edge.strip()
        if not edge:
            continue
        if '>' in edge:
            u, v = edge.split('>', 1)
            u, v = u.strip(), v.strip()
            all_nodes.add(u)
            all_nodes.add(v)
            if u not in adj:
                adj[u] = []
            adj[u].append(v)
            if v not in in_degree:
                in_degree[v] = 0
            in_degree[v] += 1
            if u not in in_degree:
                in_degree[u] = 0
        else:
            # Single isolated node case
            node = edge.strip()
            if node:
                all_nodes.add(node)
                if node not in in_degree:
                    in_degree[node] = 0
    # Ensure all nodes are initialized in adj and in_degree
    for node in all_nodes:
        if node not in adj:
            adj[node] = []
        if node not in in_degree:
            in_degree[node] = 0
    return adj, in_degree, all_nodes
def topological_sort(adj, in_degree, all_nodes):
    """
    Performs Kahn's algorithm using a min-heap to ensure lexicographical order.
    Returns (order_list, has_cycle).
    """
    if not all_nodes:
        return [], False
    # Initialize min-heap with all nodes having in-degree 0
    heap = [node for node in all_nodes if in_degree[node] == 0]
    heapq.heapify(heap)
    topo_order = []
    while heap:
        curr = heapq.heappop(heap)
        topo_order.append(curr)
        for neighbor in adj.get(curr, []):
            in_degree[neighbor] -= 1
            if in_degree[neighbor] == 0:
                heapq.heappush(heap, neighbor)
    if len(topo_order) < len(all_nodes):
        return [], True
    return topo_order, False
class GraphApp:
    """
    Tkinter GUI Application for visualizing and running the topological sort.
    """
    def __init__(self, root):
        self.root = root
        self.root.title("Topological Sort Solver")
        self.root.geometry("550x400")
        self.root.configure(bg="#f0f0f0")
        # Title Label
        title_label = tk.Label(
            root, 
            text="Topological Sort (Lexicographical)", 
            font=("Helvetica", 16, "bold"), 
            bg="#f0f0f0", 
            fg="#333333"
        )
        title_label.pack(pady=15)
        # Input Frame
        input_frame = tk.Frame(root, bg="#f0f0f0")
        input_frame.pack(pady=10, fill=tk.X, px=20)
        input_label = tk.Label(
            input_frame, 
            text="Enter Edges (e.g., a>b,a>c,b>d,c>d):", 
            font=("Helvetica", 11), 
            bg="#f0f0f0"
        )
        input_label.pack(anchor=tk.W, pady=2)
        self.entry = tk.Entry(input_frame, font=("Courier", 12), bd=2, relief=tk.GROOVE)
        self.entry.pack(fill=tk.X, ipady=4)
        self.entry.insert(0, "a>b,a>c,b>d,c>d")
        # Button Frame
        btn_frame = tk.Frame(root, bg="#f0f0f0")
        btn_frame.pack(pady=15)
        solve_btn = tk.Button(
            btn_frame, 
            text="Solve Topological Order", 
            command=self.solve, 
            font=("Helvetica", 11, "bold"), 
            bg="#4CAF50", 
            fg="white", 
            activebackground="#45a049", 
            relief=tk.RAISED, 
            padx=10, 
            pady=5
        )
        solve_btn.pack(side=tk.LEFT, padx=10)
        clear_btn = tk.Button(
            btn_frame, 
            text="Clear", 
            command=self.clear, 
            font=("Helvetica", 11), 
            bg="#f44336", 
            fg="white", 
            activebackground="#da190b", 
            relief=tk.RAISED, 
            padx=10, 
            pady=5
        )
        clear_btn.pack(side=tk.LEFT, padx=10)
        # Output Frame
        output_frame = tk.Frame(root, bg="#f0f0f0")
        output_frame.pack(pady=10, fill=tk.BOTH, expand=True, px=20)
        output_label = tk.Label(
            output_frame, 
            text="Result:", 
            font=("Helvetica", 11, "bold"), 
            bg="#f0f0f0"
        )
        output_label.pack(anchor=tk.W)
        self.result_text = tk.Text(
            output_frame, 

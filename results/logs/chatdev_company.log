'''
This module reads a directed graph from command-line arguments or a GUI,
performs a lexicographical topological sort, and handles cycle detection.
It handles duplicate edges gracefully and breaks ties lexicographically.
'''
import sys
import heapq
import tkinter as tk
from tkinter import messagebox
def parse_graph(edge_str):
    """
    Parses an edge string like 'a>b,a>c' into:
    - adj: adjacency list mapping node -> list of neighbors
    - in_degree: dictionary mapping node -> in-degree count
    - all_nodes: set of all unique nodes in the graph
    """
    adj = {}
    in_degree = {}
    all_nodes = set()
    if not edge_str.strip():
        return adj, in_degree, all_nodes
    edges = edge_str.split(',')
    seen_edges = set()
    for edge in edges:
        edge = edge.strip()
        if not edge:
            continue
        if '>' in edge:
            parts = edge.split('>')
            if len(parts) == 2:
                u, v = parts[0].strip(), parts[1].strip()
                if u and v:
                    all_nodes.add(u)
                    all_nodes.add(v)
                    # Avoid duplicate edge processing
                    if (u, v) not in seen_edges:
                        seen_edges.add((u, v))
                        if u not in adj:
                            adj[u] = []
                        adj[u].append(v)
                        in_degree[v] = in_degree.get(v, 0) + 1
                        if u not in in_degree:
                            in_degree[u] = 0
        else:
            node = edge.strip()
            if node:
                all_nodes.add(node)
    # Ensure all nodes are initialized in adj and in_degree
    for node in all_nodes:
        if node not in adj:
            adj[node] = []
        if node not in in_degree:
            in_degree[node] = 0
    return adj, in_degree, all_nodes
def topological_sort(adj, in_degree, all_nodes):
    """
    Performs Kahn's algorithm using a min-heap to ensure lexicographical order.
    Returns (order_list, has_cycle).
    """
    if not all_nodes:
        return [], False
    # Initialize min-heap with all nodes having in-degree 0
    heap = [node for node in all_nodes if in_degree[node] == 0]

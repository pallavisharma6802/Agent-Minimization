main.py
```python
'''
This program calculates and displays the n-th prime number (1-indexed, e.g., n=1 -> 2).
It supports two modes of operation:
1. CLI Mode: If a positive integer is passed as a command-line argument (sys.argv[1]),
   it prints the n-th prime to the console and exits.
2. GUI Mode: If no arguments are provided, it launches a Tkinter-based graphical user interface
   where users can input 'n' and visually see the result.
'''

import sys
import tkinter as tk
from tkinter import messagebox

def is_prime(num):
    '''Efficiently checks if a number is prime.'''
    if num < 2:
        return False
    if num == 2 or num == 3:
        return True
    if num % 2 == 0 or num % 3 == 0:
        return False
    i = 5
    while i * i <= num:
        if num % i == 0 or num % (i + 2) == 0:
            return False
        i += 6
    return True

def find_nth_prime(n):
    '''Finds and returns the n-th prime number (1-indexed).'''
    if n < 1:
        raise ValueError("n must be a positive integer (>= 1)")
    count = 0
    candidate = 1
    while count < n:
        candidate += 1
        if is_prime(candidate):
            count += 1
    return candidate

class PrimeApp:
    '''Tkinter GUI Application for finding the n-th prime number.'''
    def __init__(self, root):
        self.root = root
        self.root.title("N-th Prime Finder")
        self.root.geometry("400x250")
        self.root.resizable(False, False)
        
        # Title Label
        self.title_label = tk.Label(
            root, 
            text="N-th Prime Number Finder", 
            font=("Helvetica", 16, "bold")
        )
        self.title_label.pack(pady=15)
        
        # Input Frame
        self.input_frame = tk.Frame(root)
        self.input_frame.pack(pady=10)
        
        self.label = tk.Label(self.input_frame, text="Enter positive integer (n):", font=("Helvetica", 11))
        self.label.pack(side=tk.LEFT, padx=5)
        
        self.entry = tk.Entry(self.input_frame, width=10, font=("Helvetica", 11))
        self.entry.pack(side=tk.LEFT, padx=5)
        self.entry.focus()
        
        # Calculate Button
        self.calc_button = tk.Button(
            root, 
            text="Find Prime", 
            command=self.calculate_prime, 
            font=("Helvetica", 11, "bold"),
            bg="#4CAF50",
            fg="white",
            activebackground="#45a049",
            activeforeground="white"
        )
        self.calc_button.pack(pady=10)
        
        # Result Label
        self.result_label = tk.Label(
            root, 
            text="", 
            font=("Helvetica", 12, "italic"),
            fg="#333333"
        )
        self.result_label.pack(pady=10)

    def calculate_prime(self):
        '''Handles the button click, validates input, and displays the result.'''
        input_val = self.entry.get().strip()
        if not input_val:
            messagebox.showerror("Input Error", "Please enter an integer value.")
            return
        
        try:
            n = int(input_val)
            if n <= 0:
                raise ValueError
        except ValueError:
            messagebox.showerror("Input Error", "Please enter a valid positive integer (n >= 1).")
            return
        
        try:
            # Show a temporary calculating status for larger numbers
            self.result_label.config(text="Calculating...", fg="blue")
            self.root.update_idletasks()
            
            prime = find_nth_prime(n)
            self.result_label.config(
                text=f"The {n}-th prime number is: {prime}", 
                fg="green"
            )
        except Exception as e:
            messagebox.showerror("Error", f"An error occurred: {str(e)}")
            self.result_label.config(text="")

def main():
    '''Entry point of the application.'''
    # If command-line arguments are provided, run in CLI mode
    if len(sys.argv) > 1:
        try:
            n = int(sys.argv[1])
            if n < 1:
                print("Error: The input must be a positive integer (>= 1).", file=sys.stderr)
                sys.exit(1)
            result = find_nth_prime(n)
            print(result)
            sys.exit(0)
        except ValueError:
            print("Error: Please provide a valid positive integer as an argument.", file=sys.stderr)
            sys.exit(1)
    else:
        # If no arguments are provided, launch the GUI
        root = tk.Tk()
        app = PrimeApp(root)
        root.mainloop()

if __name__ == "__main__":
    main()
```


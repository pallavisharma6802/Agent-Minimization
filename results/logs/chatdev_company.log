'''
This module contains the core logic for generating the FizzBuzz sequence.
'''
def generate_fizzbuzz_sequence(n: int):
    """
    Generates the FizzBuzz sequence from 1 to n.
    :param n: The upper limit of the sequence (inclusive).
    :return: A list of strings representing the FizzBuzz sequence.
    """
    sequence = []
    for i in range(1, n + 1):
        if i % 3 == 0 and i % 5 == 0:
            sequence.append("FizzBuzz")
        elif i % 3 == 0:
            sequence.append("Fizz")
        elif i % 5 == 0:
            sequence.append("Buzz")
        else:
            sequence.append(str(i))
    return sequence

```python
'''
The main entry point of the application. Handles command-line arguments for CLI execution
and falls back to GUI mode if no arguments are provided.
'''
import sys
import tkinter as tk
from fizzbuzz import generate_fizzbuzz_sequence
from gui import FizzBuzzGUI
def main():
    # If an argument is passed via command line, run in CLI mode
    if len(sys.argv) > 1:
        try:
            n = int(sys.argv[1])
            if n < 1:
                print("Error: N must be an integer greater than or equal to 1.", file=sys.stderr)
                sys.exit(1)
            sequence = generate_fizzbuzz_sequence(n)
            for item in sequence:
                print(item)
        except ValueError:
            print("Error: The provided argument must be an integer.", file=sys.stderr)
            sys.exit(1)
    else:
        # No command-line arguments provided, launch GUI mode
        root = tk.Tk()
        app = FizzBuzzGUI(root)
        root.mainloop()
if __name__ == "__main__":
    main()

'''
The main entry point of the application. Handles command-line arguments
if provided, otherwise launches the graphical user interface.
'''
import sys
import tkinter as tk
from converter import RomanConverter
from gui import RomanGUI
def main():
    # If a command-line argument is provided, run in CLI mode
    if len(sys.argv) > 1:
        roman_input = sys.argv[1]
        try:
            integer_value = RomanConverter.roman_to_int(roman_input)
            print(integer_value)
            sys.exit(0)
        except ValueError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
    else:
        # Otherwise, launch the GUI
        root = tk.Tk()
        app = RomanGUI(root)
        root.mainloop()
if __name__ == "__main__":
    main()

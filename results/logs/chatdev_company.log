+If an expression is passed as a command-line argument (sys.argv[1]), it evaluates it,
+prints the integer result, and exits.
+If no command-line argument is provided, it launches a Tkinter GUI for interactive evaluation.
+'''
+import sys
+import tkinter as tk
+from tkinter import messagebox
+def evaluate_rpn(expression: str) -> int:
+    '''
+    Evaluates a space-separated Reverse Polish Notation (RPN) expression.
+    Supports integers and operators: +, -, *, /
+    Division truncates toward zero.
+    '''
+    tokens = expression.strip().split()
+    if not tokens:
+        raise ValueError("Expression is empty")
+    stack = []
+    for token in tokens:
+        if token in ('+', '-', '*', '/'):
+            if len(stack) < 2:
+                raise ValueError("Invalid RPN expression: insufficient operands")
+            b = stack.pop()
+            a = stack.pop()
+            if token == '+':
+                result = a + b
+            elif token == '-':
+                result = a - b
+            elif token == '*':
+                result = a * b
+            elif token == '/':
+                if b == 0:
+                    raise ZeroDivisionError("Division by zero")
+                # Integer division truncating toward zero
+                result = int(a / b)
+            stack.append(result)
+        else:
+            try:
+                # Parse token as integer
+                number = int(token)
+                stack.append(number)
+            except ValueError:
+                raise ValueError(f"Invalid token: '{token}'")
+    if len(stack) != 1:
+        raise ValueError("Invalid RPN expression: too many operands")
+    return stack[0]
+class RPNGUIApp:
+    '''
+    A Tkinter GUI application for interactive RPN evaluation.
+    '''
+    def __init__(self, root):
+        self.root = root
+        self.root.title("RPN Calculator")
+        self.root.geometry("450x250")
+        self.root.resizable(False, False)
+        # Title Label
+        self.title_label = tk.Label(
+            root, 
+            text="Reverse Polish Notation Evaluator", 
+            font=("Helvetica", 14, "bold")
+        )
+        self.title_label.pack(pady=15)
+        # Input Frame
+        self.input_frame = tk.Frame(root)
+        self.input_frame.pack(pady=10, fill='x', px=20)
+        self.entry_label = tk.Label(
+            self.input_frame, 
+            text="Enter RPN (space-separated):", 
+            font=("Helvetica", 10)
+        )
+        self.entry_label.pack(anchor='w')
+        self.entry = tk.Entry(
+            self.input_frame, 
+            font=("Helvetica", 12), 
+            width=40
+        )
+        self.entry.pack(pady=5, fill='x')
+        self.entry.insert(0, "3 4 + 2 * 7 /")  # Default example
+        # Button
+        self.eval_button = tk.Button(
+            root, 
+            text="Evaluate", 
+            command=self.process_evaluation, 
+            font=("Helvetica", 11, "bold"),
+            bg="#4CAF50",
+            fg="white"
+        )
+        self.eval_button.pack(pady=10)
+        # Result Label
+        self.result_label = tk.Label(
+            root, 
+            text="Result: ", 
+            font=("Helvetica", 12, "bold"),
+            fg="#333333"
+        )
+        self.result_label.pack(pady=10)
+    def process_evaluation(self):
+        expr = self.entry.get()
+        try:
+            res = evaluate_rpn(expr)
+            self.result_label.config(text=f"Result: {res}", fg="green")
+        except Exception as e:
+            self.result_label.config(text="Result: Error", fg="red")
+            messagebox.showerror("Error", str(e))
+if __name__ == "__main__":
+    # If a command-line argument is provided, evaluate it and print the result
+    if len(sys.argv) > 1:
+        expression_arg = sys.argv[1]
+        try:
+            result = evaluate_rpn(expression_arg)
+            print(result)
+            sys.exit(0)
+        except Exception as e:
+            print(f"Error: {e}", file=sys.stderr)
+            sys.exit(1)
+    else:
+        # Otherwise, launch the GUI
+        root = tk.Tk()
+        app = RPNGUIApp(root)
+        root.mainloop()

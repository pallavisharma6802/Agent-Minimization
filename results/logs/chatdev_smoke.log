calculator.py
```python
'''
This module provides a safe arithmetic expression evaluator supporting integers,
addition (+), subtraction (-), multiplication (*), division (/), and parentheses.
It uses a recursive descent parser to avoid using the unsafe eval() function.
'''

import re

class Calculator:
    def __init__(self, expression: str):
        self.expression = expression
        self.tokens = self._tokenize(expression)
        self.pos = 0

    def _tokenize(self, expression: str) -> list:
        # Tokenize integers, operators, and parentheses, ignoring whitespace
        token_specification = [
            ('NUMBER',   r'\d+'),       # Integer
            ('OP',       r'[+\-*/()]'), # Operators and Parentheses
            ('SKIP',     r'\s+'),       # Skip spaces
            ('MISMATCH', r'.'),         # Any other character
        ]
        tok_regex = '|'.join('(?P<%s>%s)' % pair for pair in token_specification)
        tokens = []
        for mo in re.finditer(tok_regex, expression):
            kind = mo.lastgroup
            value = mo.group()
            if kind == 'NUMBER':
                tokens.append(('NUMBER', int(value)))
            elif kind == 'OP':
                tokens.append(('OP', value))
            elif kind == 'SKIP':
                continue
            elif kind == 'MISMATCH':
                raise ValueError(f"Unexpected character: {value}")
        return tokens

    def _peek(self):
        if self.pos < len(self.tokens):
            return self.tokens[self.pos]
        return None

    def _consume(self, expected_type=None, expected_value=None):
        token = self._peek()
        if token is None:
            raise ValueError("Unexpected end of expression")
        if expected_type and token[0] != expected_type:
            raise ValueError(f"Expected token type {expected_type}, got {token[0]}")
        if expected_value and token[1] != expected_value:
            raise ValueError(f"Expected token value {expected_value}, got {token[1]}")
        self.pos += 1
        return token

    def evaluate(self):
        if not self.tokens:
            raise ValueError("Empty expression")
        result = self._expr()
        if self.pos < len(self.tokens):
            raise ValueError(f"Unparsed tokens remaining at position {self.pos}")
        return result

    def _expr(self):
        # expr = term (( '+' | '-' ) term)*
        result = self._term()
        while True:
            token = self._peek()
            if token and token[0] == 'OP' and token[1] in ('+', '-'):
                op = self._consume()[1]
                right = self._term()
                if op == '+':
                    result += right
                else:
                    result -= right
            else:
                break
        return result

    def _term(self):
        # term = factor (( '*' | '/' ) factor)*
        result = self._factor()
        while True:
            token = self._peek()
            if token and token[0] == 'OP' and token[1] in ('*', '/'):
                op = self._consume()[1]
                right = self._factor()
                if op == '*':
                    result *= right
                else:
                    if right == 0:
                        raise ZeroDivisionError("Division by zero")
                    # Perform float division, convert to int if it's a whole number
                    div_result = result / right
                    result = int(div_result) if div_result.is_integer() else div_result
            else:
                break
        return result

    def _factor(self):
        # factor = NUMBER | '(' expr ')' | '-' factor | '+' factor
        token = self._peek()
        if token is None:
            raise ValueError("Unexpected end of expression in factor")

        if token[0] == 'NUMBER':
            self._consume()
            return token[1]
        elif token[0] == 'OP' and token[1] == '(':
            self._consume('OP', '(')
            result = self._expr()
            self._consume('OP', ')')
            return result
        elif token[0] == 'OP' and token[1] == '-':
            self._consume('OP', '-')
            return -self._factor()
        elif token[0] == 'OP' and token[1] == '+':
            self._consume('OP', '+')
            return self._factor()
        else:
            raise ValueError(f"Unexpected token in factor: {token[1]}")

def calculate(expression: str):
    calc = Calculator(expression)
    return calc.evaluate()
```

gui.py
```python
'''
This module provides a Graphical User Interface (GUI) for the calculator using tkinter.
It allows users to input expressions via buttons or keyboard and displays the result.
'''

import tkinter as tk
from tkinter import messagebox
from calculator import calculate

class CalculatorGUI:
    def __init__(self, root):
        self.root = root
        self.root.title("Calculator")
        self.root.geometry("350x450")
        self.root.resizable(False, False)

        self.expression = ""

        # Display Screen
        self.display_var = tk.StringVar()
        self.display = tk.Entry(
            root, 
            textvariable=self.display_var, 
            font=("Arial", 20), 
            bd=10, 
            insertwidth=4, 
            width=14, 
            borderwidth=0, 
            justify="right"
        )
        self.display.grid(row=0, column=0, columnspan=4, ipady=15, sticky="nsew")

        # Button layout
        buttons = [
            ('C', 1, 0), ('(', 1, 1), (')', 1, 2), ('/', 1, 3),
            ('7', 2, 0), ('8', 2, 1), ('9', 2, 2), ('*', 2, 3),
            ('4', 3, 0), ('5', 3, 1), ('6', 3, 2), ('-', 3, 3),
            ('1', 4, 0), ('2', 4, 1), ('3', 4, 2), ('+', 4, 3),
            ('0', 5, 0), ('.', 5, 1), ('=', 5, 2)
        ]

        # Configure grid weights
        for i in range(6):
            root.rowconfigure(i, weight=1)
        for i in range(4):
            root.columnconfigure(i, weight=1)

        # Create and place buttons
        for (text, row, col) in buttons:
            action = lambda x=text: self.on_button_click(x)
            if text == '=':
                btn = tk.Button(root, text=text, command=action, bg="#4CAF50", fg="white", font=("Arial", 14))
                btn.grid(row=row, column=col, columnspan=2, sticky="nsew", padx=2, pady=2)
            else:
                btn = tk.Button(root, text=text, command=action, font=("Arial", 14))
                btn.grid(row=row, column=col, sticky="nsew", padx=2, pady=2)

        # Bind keyboard keys
        self.root.bind("<Key>", self.on_key_press)

    def on_button_click(self, char):
        if char == 'C':
            self.expression = ""
            self.display_var.set("")
        elif char == '=':
            self.perform_calculation()
        else:
            self.expression += str(char)
            self.display_var.set(self.expression)

    def on_key_press(self, event):
        char = event.char
        if char in "0123456789+-*/()":
            self.expression += char
            self.display_var.set(self.expression)
        elif char == '\r' or char == '=':  # Enter key
            self.perform_calculation()
        elif event.keysym == 'BackSpace':
            self.expression = self.expression[:-1]
            self.display_var.set(self.expression)
        elif event.keysym == 'Escape':
            self.expression = ""
            self.display_var.set("")

    def perform_calculation(self):
        try:
            result = calculate(self.expression)
            self.display_var.set(str(result))
            self.expression = str(result)
        except Exception as e:
            messagebox.showerror("Error", f"Invalid Expression\n{str(e)}")
            self.expression = ""
            self.display_var.set("")

'''
This module provides a Graphical User Interface (GUI) for the calculator using tkinter.
It allows users to input expressions via buttons or keyboard and displays the result.
'''

import tkinter as tk
from tkinter import messagebox
from calculator import calculate

class CalculatorGUI:
    def __init__(self, root):
        self.root = root
        self.root.title("Calculator")
        self.root.geometry("350x450")
        self.root.resizable(False, False)

        self.expression = ""

        # Display Screen
        self.display_var = tk.StringVar()
        self.display = tk.Entry(
            root, 
            textvariable=self.display_var, 
            font=("Arial", 20), 
            bd=10, 
            insertwidth=4, 
            width=14, 
            borderwidth=0, 
            justify="right"
        )
        self.display.grid(row=0, column=0, columnspan=4, ipady=15, sticky="nsew")

        # Button layout
        buttons = [
            ('C', 1, 0), ('(', 1, 1), (')', 1, 2), ('/', 1, 3),
            ('7', 2, 0), ('8', 2, 1), ('9', 2, 2), ('*', 2, 3),
            ('4', 3, 0), ('5', 3, 1), ('6', 3, 2), ('-', 3, 3),
            ('1', 4, 0), ('2', 4, 1), ('3', 4, 2), ('+', 4, 3),
            ('0', 5, 0), ('.', 5, 1), ('=', 5, 2)
        ]

        # Configure grid weights
        for i in range(6):
            root.rowconfigure(i, weight=1)
        for i in range(4):
            root.columnconfigure(i, weight=1)

        # Create and place buttons
        for (text, row, col) in buttons:
            action = lambda x=text: self.on_button_click(x)
            if text == '=':
                btn = tk.Button(root, text=text, command=action, bg="#4CAF50", fg="white", font=("Arial", 14))
                btn.grid(row=row, column=col, columnspan=2, sticky="nsew", padx=2, pady=2)
            else:
                btn = tk.Button(root, text=text, command=action, font=("Arial", 14))
                btn.grid(row=row, column=col, sticky="nsew", padx=2, pady=2)

        # Bind keyboard keys
        self.root.bind("<Key>", self.on_key_press)

    def on_button_click(self, char):
        if char == 'C':
            self.expression = ""
            self.display_var.set("")
        elif char == '=':
            self.perform_calculation()
        else:
            self.expression += str(char)
            self.display_var.set(self.expression)

    def on_key_press(self, event):
        char = event.char
        if char in "0123456789+-*/()":
            self.expression += char
            self.display_var.set(self.expression)
        elif char == '\r' or char == '=':  # Enter key
            self.perform_calculation()
        elif event.keysym == 'BackSpace':
            self.expression = self.expression[:-1]
            self.display_var.set(self.expression)
        elif event.keysym == 'Escape':
            self.expression = ""
            self.display_var.set("")

    def perform_calculation(self):
        try:
            result = calculate(self.expression)
            self.display_var.set(str(result))
            self.expression = str(result)
        except Exception as e:
            messagebox.showerror("Error", f"Invalid Expression\n{str(e)}")
            self.expression = ""

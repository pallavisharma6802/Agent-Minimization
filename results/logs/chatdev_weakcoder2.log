**evaluator.py**

```python
'''
evaluator.py

Provides a single function `evaluate_rpn` that parses a space‑separated
Reverse Polish Notation expression and returns the integer result.
Division truncates toward zero, matching the specification.
'''

def evaluate_rpn(expression: str) -> int:
    """
    Evaluate a Reverse Polish Notation (RPN) expression.

    Parameters
    ----------
    expression : str
        Space‑separated tokens consisting of integers and the operators
        '+', '-', '*', '/'.

    Returns
    -------
    int
        The integer result of evaluating the expression.

    Raises
    ------
    ValueError
        If the expression is malformed (e.g., insufficient operands,
        unknown token, or leftover operands after evaluation).
    ZeroDivisionError
        If a division by zero occurs.
    """
    if not expression.strip():
        raise ValueError("Empty expression")

    tokens = expression.strip().split()
    stack = []

    for token in tokens:
        if token in ('+', '-', '*', '/'):
            if len(stack) < 2:
                raise ValueError(f"Insufficient operands for operator '{token}'")
            b = stack.pop()
            a = stack.pop()

            if token == '+':
                stack.append(a + b)
            elif token == '-':
                stack.append(a - b)
            elif token == '*':
                stack.append(a * b)
            elif token == '/':
                if b == 0:
                    raise ZeroDivisionError("Division by zero")
                # Truncate toward zero
                stack.append(int(a / b))
        else:
            try:
                stack.append(int(token))
            except ValueError:
                raise ValueError(f"Invalid token '{token}'")

    if len(stack) != 1:
        raise ValueError("The expression has too many operands")

    return stack[0]
```


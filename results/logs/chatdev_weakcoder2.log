'''
Main entry point.
If a command‑line argument is supplied, the program reads the edge
string from sys.argv[1], performs topological sorting, and prints
the result (or 'CYCLE' if a cycle is detected).  If no argument
is supplied, a Tkinter GUI is launched for interactive use.
'''
import sys
import tkinter as tk
from graph import Graph
from sorter import TopologicalSorter
from gui import GUIApp
def run_cli(edge_str: str):
    try:
        graph = Graph(edge_str)
        order = TopologicalSorter.sort(graph)
        if order is None:
            print("CYCLE")

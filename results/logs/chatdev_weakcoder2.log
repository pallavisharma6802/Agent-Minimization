#!/usr/bin/env python3
"""
main.py

Entry point for the RPN Calculator application.  
If a command‑line argument is supplied, it evaluates the RPN expression
and prints the integer result.  
Regardless of command‑line usage, it launches a Tkinter GUI that allows
interactive evaluation of RPN expressions.
"""

import sys
from evaluator import evaluate_rpn
from gui import RPNCalculatorGUI

def main() -> None:
    """
    Parse command‑line argument (if any) and evaluate the RPN expression.
    Then start the GUI event loop.
    """
    if len(sys.argv) > 1:
        expr = sys.argv[1]
        try:
            result = evaluate_rpn(expr)
            print(result)
        except Exception as exc:
            print(f"Error evaluating expression: {exc}", file=sys.stderr)

    # Launch the GUI
    app = RPNCalculatorGUI()
    app.mainloop()

if __name__ == "__main__":
    main()

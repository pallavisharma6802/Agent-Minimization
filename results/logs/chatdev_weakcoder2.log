# sorter.py
'''
TopologicalSorter
=================
Implements Kahn's algorithm with a min‑heap to produce a
lexicographically smallest topological order.  Detects cycles.
'''
import heapq
from typing import List, Optional
from graph import Graph
class TopologicalSorter:
    '''
    Topological sorter for directed graphs.
    Methods
    -------
    sort(graph: Graph) -> Optional[List[str]]
        Returns a list of nodes in topological order, or None if a cycle exists.
    '''
    @staticmethod
    def sort(graph: Graph) -> Optional[List[str]]:
        '''
        Perform topological sorting.
        Parameters
        ----------
        graph : Graph
            The graph to sort.
        Returns
        -------
        Optional[List[str]]
            A list of nodes in topological order, or None if a cycle is detected.
        '''
        # Min‑heap of nodes with indegree 0
        zero_indeg = [node for node in graph.nodes if graph.indegree.get(node, 0) == 0]
        heapq.heapify(zero_indeg)
        order: List[str] = []
        while zero_indeg:
            node = heapq.heappop(zero_indeg)
            order.append(node)
            for neighbor in graph.adjacency.get(node, []):
                graph.indegree[neighbor] -= 1
                if graph.indegree[neighbor] == 0:
                    heapq.heappush(zero_indeg, neighbor)
        if len(order) != len(graph.nodes):
            # Cycle detected
            return None
        return order

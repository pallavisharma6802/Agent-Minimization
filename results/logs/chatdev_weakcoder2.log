```python
'''
Utility module for converting Roman numerals to integers.
Provides a single public function `roman_to_int` that validates
the input and handles subtractive notation (IV, IX, XL, XC, CD, CM).
'''
def roman_to_int(s: str) -> int:
    """
    Convert a Roman numeral string to an integer.
    Parameters
    ----------
    s : str
        Roman numeral string (e.g., "MCMXCIV").
    Returns
    -------
    int
        Integer value of the Roman numeral.
    Raises
    ------
    ValueError
        If the input contains characters that are not valid Roman numerals.
    """
    if not s:
        raise ValueError("Input string is empty")
    roman_map = {
        'I': 1,
        'V': 5,
        'X': 10,
        'L': 50,
        'C': 100,
        'D': 500,
        'M': 1000
    }
    total = 0
    prev_value = 0
    for char in s.upper():
        if char not in roman_map:
            raise ValueError(f"Invalid Roman numeral character: '{char}'")
        value = roman_map[char]
        if value > prev_value:
            # Subtractive case: subtract twice the previous value
            total += value - 2 * prev_value
        else:
            total += value
        prev_value = value
    return total

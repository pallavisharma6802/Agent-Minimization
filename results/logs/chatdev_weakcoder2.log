**gui.py**

```python
'''
gui.py

Tkinter GUI for computing the n-th prime number.
'''

import tkinter as tk
from tkinter import ttk, messagebox
from prime_utils import nth_prime

class PrimeGUI(tk.Tk):
    """Main application window for prime calculation."""
    def __init__(self):
        super().__init__()
        self.title("Nth Prime Calculator")
        self.geometry("300x150")
        self.resizable(False, False)
        self.create_widgets()

    def create_widgets(self):
        """Create and layout widgets."""
        frame = ttk.Frame(self, padding="10")
        frame.pack(fill=tk.BOTH, expand=True)

        ttk.Label(frame, text="Enter n:").grid(row=0, column=0, sticky=tk.W, pady=5)
        self.n_entry = ttk.Entry(frame, width=20)
        self.n_entry.grid(row=0, column=1, pady=5)
        self.n_entry.focus()

        compute_btn = ttk.Button(frame, text="Compute", command=self.compute_prime)
        compute_btn.grid(row=1, column=0, columnspan=2, pady=10)

        self.result_var = tk.StringVar(value="Result will appear here")
        result_label = ttk.Label(frame, textvariable=self.result_var, foreground="blue")
        result_label.grid(row=2, column=0, columnspan=2, pady=5)

    def compute_prime(self):
        """Handle compute button click."""
        n_str = self.n_entry.get().strip()
        if not n_str.isdigit():
            messagebox.showerror("Invalid input", "Please enter a positive integer.")
            return
        n = int(n_str)
        try:
            prime = nth_prime(n)
            self.result_var.set(f"The {n}-th prime is {prime}")
        except Exception as e:
            messagebox.showerror("Error", str(e))
```

These three files together provide a fully functional command‑line and GUI application that prints or displays the n‑th prime number.


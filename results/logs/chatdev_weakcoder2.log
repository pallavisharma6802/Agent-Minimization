"roman_converter.py
```python
'''
Utility module for converting Roman numerals to integers.
Provides a single public function `roman_to_int` that validates
the input and handles subtractive notation (IV, IX, XL, XC, CD, CM).
'''
def roman_to_int(s: str) -> int:
    """
    Convert a Roman numeral string to an integer.
    Parameters
    ----------
    s : str
        Roman numeral string (e.g., "MCMXCIV").
    Returns
    -------
    int
        Integer value of the Roman numeral.
    Raises
    ------
    ValueError
        If the input contains characters that are not valid Roman numerals.
    """
    if not s:
        raise ValueError("Input string is empty")
    roman_map = {
        'I': 1,
        'V': 5,
        'X': 10,
        'L': 50,
        'C': 100,
        'D': 500,
        'M': 1000
    }
    total = 0
    prev_value = 0
    for char in s.upper():
        if char not in roman_map:
            raise ValueError(f"Invalid Roman numeral character: '{char}'")
        value = roman_map[char]
        if value > prev_value:
            # Subtractive case: subtract twice the previous value
            total += value - 2 * prev_value
        else:
            total += value
        prev_value = value
    return total
```

gui.py
```python
'''
Tkinter GUI for Roman numeral conversion.
Provides a window with an entry field, a Convert button,
and a label that displays the integer result or an error message.
'''
import tkinter as tk
from tkinter import ttk, messagebox
from roman_converter import roman_to_int
class RomanConverterGUI(tk.Tk):
    """
    Main application window for Roman numeral conversion.
    """
    def __init__(self):
        super().__init__()
        self.title("Roman Numeral Converter")
        self.resizable(False, False)
        self._create_widgets()
    def _create_widgets(self):
        """Create and layout the widgets."""
        padding = {'padx': 10, 'pady': 10}
        # Input label and entry
        ttk.Label(self, text="Roman Numeral:").grid(row=0, column=0, **padding, sticky='e')
        self.input_var = tk.StringVar()
        self.entry = ttk.Entry(self, textvariable=self.input_var, width=20)
        self.entry.grid(row=0, column=1, **padding)
        self.entry.focus()
        # Convert button
        self.convert_btn = ttk.Button(self, text="Convert", command=self._convert)
        self.convert_btn.grid(row=1, column=0, columnspan=2, **padding)
        # Result label
        self.result_var = tk.StringVar(value="Result will appear here")
        self.result_label = ttk.Label(self, textvariable=self.result_var, foreground="blue")
        self.result_label.grid(row=2, column=0, columnspan=2, **padding)
        # Bind Return key to conversion
        self.bind('<Return>', lambda event: self._convert())
    def _convert(self):
        """Handle the conversion when the button is pressed."""
        roman = self.input_var.get().strip()
        if not roman:
            messagebox.showwarning("Input Required", "Please enter a Roman numeral.")
            return
        try:
            value = roman_to_int(roman)
            self.result_var.set(f"{roman.upper()} = {value}")
        except ValueError as e:
            self.result_var.set(f"Error: {e}")
```

main.py
```python
'''
Entry point for the Roman numeral converter.
If a command‑line argument is provided, it prints the integer value.
Otherwise, it launches the Tkinter GUI.
'''
import sys
from roman_converter import roman_to_int
from gui import RomanConverterGUI
def main():
    if len(sys.argv) > 1:
        # Command‑line mode: convert and print
        roman = sys.argv[1]
        try:
            value = roman_to_int(roman)
            print(value)
        except ValueError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
    else:
        # GUI mode
        app = RomanConverterGUI()
        app.mainloop()
if __name__ == "__main__":
    main()

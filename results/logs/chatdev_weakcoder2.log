import tkinter as tk
from tkinter import ttk, messagebox
from roman_converter import roman_to_int
class RomanConverterGUI(tk.Tk):
    """
    Main application window for Roman numeral conversion.
    """
    def __init__(self):
        super().__init__()
        self.title("Roman Numeral Converter")
        self.resizable(False, False)
        self._create_widgets()
    def _create_widgets(self):
        """Create and layout the widgets."""
        padding = {'padx': 10, 'pady': 10}
        # Input label and entry
        ttk.Label(self, text="Roman Numeral:").grid(row=0, column=0, **padding, sticky='e')
        self.input_var = tk.StringVar()
        self.entry = ttk.Entry(self, textvariable=self.input_var, width=20)
        self.entry.grid(row=0, column=1, **padding)
        self.entry.focus()
        # Convert button
        self.convert_btn = ttk.Button(self, text="Convert", command=self._convert)
        self.convert_btn.grid(row=1, column=0, columnspan=2, **padding)
        # Result label
        self.result_var = tk.StringVar(value="Result will appear here")
        self.result_label = ttk.Label(self, textvariable=self.result_var, foreground="blue")
        self.result_label.grid(row=2, column=0, columnspan=2, **padding)
        # Bind Return key to conversion
        self.bind('<Return>', lambda event: self._convert())
    def _convert(self):
        """Handle the conversion when the button is pressed."""
        roman = self.input_var.get().strip()
        if not roman:
            messagebox.showwarning("Input Required", "Please enter a Roman numeral.")
            return
        try:
            value = roman_to_int(roman)
            self.result_var.set(f"{roman.upper()} = {value}")
        except ValueError as e:
            self.result_var.set(f"Error: {e}")

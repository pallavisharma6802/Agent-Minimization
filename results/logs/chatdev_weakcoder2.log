## `gui.py`

```python
# gui.py

'''
gui.py

Defines the RomanConverterGUI class that creates a Tkinter window
allowing users to input a Roman numeral and see its integer value.
'''

import tkinter as tk
from tkinter import ttk
from roman_converter import RomanConverter

class RomanConverterGUI:
    """
    GUI application for converting Roman numerals to integers.
    """

    def __init__(self, master: tk.Tk) -> None:
        """
        Initialize the GUI components.

        Parameters
        ----------
        master : tk.Tk
            The root Tkinter window.
        """
        self.master = master
        self.create_widgets()

    def create_widgets(self) -> None:
        """
        Create and layout the widgets in the GUI.
        """
        # Input frame
        input_frame = ttk.Frame(self.master, padding="10")
        input_frame.grid(row=0, column=0, sticky="EW")

        ttk.Label(input_frame, text="Roman Numeral:").grid(row=0, column=0, sticky="W")
        self.entry = ttk.Entry(input_frame, width=30)
        self.entry.grid(row=0, column=1, padx=5, pady=5)
        self.entry.focus()

        # Convert button
        convert_btn = ttk.Button(input_frame, text="Convert", command=self.convert)
        convert_btn.grid(row=0, column=2, padx=5)

        # Result frame
        result_frame = ttk.Frame(self.master, padding="10")
        result_frame.grid(row=1, column=0, sticky="EW")

        ttk.Label(result_frame, text="Integer Value:").grid(row=0, column=0, sticky="W")
        self.result_var = tk.StringVar()
        self.result_label = ttk.Label(result_frame, textvariable=self.result_var, foreground="blue")
        self.result_label.grid(row=0, column=1, sticky="W")

        # Configure column weights
        self.master.columnconfigure(0, weight=1)
        input_frame.columnconfigure(1, weight=1)

    def convert(self) -> None:
        """
        Callback for the Convert button. Reads the input, performs conversion,
        and displays the result or an error message.
        """
        roman_numeral = self.entry.get().strip()
        if not roman_numeral:
            self.result_var.set("Please enter a Roman numeral.")
            return

        try:
            value = RomanConverter.roman_to_int(roman_numeral)
            self.result_var.set(str(value))
        except ValueError as e:
            self.result_var.set(f"Error: {e}")
```


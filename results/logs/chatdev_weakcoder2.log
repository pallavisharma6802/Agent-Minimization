            row=0, column=1, sticky='w'
        )
        # --- Command Entry -----------------------------------------------
        ttk.Label(master, text="Commands:").grid(row=1, column=0, sticky='w')
        self.command_entry = ttk.Entry(master, width=50)
        self.command_entry.grid(row=1, column=1, columnspan=3, sticky='we')
        # --- Run Button --------------------------------------------------
        ttk.Button(master, text="Run", command=self.run_command).grid(
            row=2, column=1, pady=5
        )
        # --- Output ------------------------------------------------------
        ttk.Label(master, text="Output:").grid(row=3, column=0, sticky='nw')
        self.output_text = tk.Text(master, height=5, width=60)
        self.output_text.grid(row=3, column=1, columnspan=3, sticky='we')
        # --- Layout ------------------------------------------------------
        master.columnconfigure(1, weight=1)
        master.columnconfigure(2, weight=1)
        master.columnconfigure(3, weight=1)
    def run_command(self) -> None:
        """Parse the command string and display results."""
        capacity = self.capacity_var.get()
        command_str = self.command_entry.get()
        results = process_commands(command_str, capacity=capacity)
        self.output_text.delete(1.0, tk.END)
        self.output_text.insert(tk.END, ' '.join(map(str, results)))
def run_gui() -> None:
    """Launch the Tkinter event loop."""
    root = tk.Tk()
    app = LRUCacheGUI(root)
    root.mainloop()

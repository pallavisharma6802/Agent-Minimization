# graph.py
'''
Graph
=====
Represents a directed graph built from an edge string of the form
'a>b,a>c,b>d,c>d'.  Provides adjacency list and indegree mapping
required for topological sorting.
'''
from collections import defaultdict
from typing import Dict, Set, List
class Graph:
    '''
    Graph representation.
    Attributes
    ----------
    adjacency : Dict[str, Set[str]]
        Mapping from a node to the set of its outgoing neighbors.
    indegree : Dict[str, int]
        Mapping from a node to its indegree count.
    nodes : Set[str]
        Set of all nodes in the graph.
    '''
    def __init__(self, edge_str: str):
        '''
        Construct a graph from an edge string.
        Parameters
        ----------
        edge_str : str
            Edge list string, e.g. 'a>b,a>c,b>d,c>d'.
        '''
        self.adjacency: Dict[str, Set[str]] = defaultdict(set)
        self.indegree: Dict[str, int] = defaultdict(int)
        self.nodes: Set[str] = set()
        if not edge_str:
            return
        edges = edge_str.split(',')
        for edge in edges:
            if '>' not in edge:
                raise ValueError(f"Invalid edge format: '{edge}'. Expected 'u>v'.")
            u, v = edge.split('>', 1)
            u, v = u.strip(), v.strip()
            if not u or not v:
                raise ValueError(f"Empty node in edge: '{edge}'.")
            self.nodes.update([u, v])
            self.adjacency[u].add(v)
            self.indegree[v] += 1
            # Ensure all nodes appear in indegree map
            self.indegree.setdefault(u, self.indegree.get(u, 0))
    def __repr__(self):
        return f"Graph(nodes={self.nodes}, adjacency={dict(self.adjacency)})"
```

sorter.py
```python
# sorter.py
'''
TopologicalSorter
=================
Implements Kahn's algorithm with a min‑heap to produce a
lexicographically smallest topological order.  Detects cycles.
'''
import heapq
from typing import List, Optional
from graph import Graph
class TopologicalSorter:
    '''
    Topological sorter for directed graphs.
    Methods
    -------
    sort(graph: Graph) -> Optional[List[str]]
        Returns a list of nodes in topological order, or None if a cycle exists.
    '''
    @staticmethod
    def sort(graph: Graph) -> Optional[List[str]]:
        '''
        Perform topological sorting.
        Parameters
        ----------
        graph : Graph
            The graph to sort.
        Returns
        -------
        Optional[List[str]]
            A list of nodes in topological order, or None if a cycle is detected.
        '''
        # Min‑heap of nodes with indegree 0
        zero_indeg = [node for node in graph.nodes if graph.indegree.get(node, 0) == 0]
        heapq.heapify(zero_indeg)
        order: List[str] = []
        while zero_indeg:
            node = heapq.heappop(zero_indeg)
            order.append(node)
            for neighbor in graph.adjacency.get(node, []):
                graph.indegree[neighbor] -= 1
                if graph.indegree[neighbor] == 0:
                    heapq.heappush(zero_indeg, neighbor)
        if len(order) != len(graph.nodes):
            # Cycle detected
            return None
        return order

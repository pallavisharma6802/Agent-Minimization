            except ValueError:
                pass  # Ignore malformed integer arguments
        elif action == 'get' and len(parts) == 2:
            try:
                key = int(parts[1])
                results.append(cache.get(key))
            except ValueError:
                pass  # Ignore malformed integer arguments
    return results


def main() -> None:

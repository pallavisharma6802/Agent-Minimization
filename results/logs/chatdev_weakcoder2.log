# gui.py

'''
Graphical user interface for topological sorting.

Uses Tkinter to provide a simple window where the user can
enter an edge string, press a button, and see the resulting
topological order or a cycle message.
'''

import tkinter as tk
from tkinter import ttk, messagebox
from typing import Optional

from graph import Graph


class TopoSortGUI(tk.Tk):
    '''
    Main application window.
    '''

    def __init__(self):
        super().__init__()
        self.title("Topological Sorter")
        self.resizable(False, False)

        # Input frame
        input_frame = ttk.Frame(self, padding="10")
        input_frame.grid(row=0, column=0, sticky="ew")

        ttk.Label(input_frame, text="Enter edges (e.g., a>b,a>c):").grid(
            row=0, column=0, sticky="w"
        )
        self.edge_entry = ttk.Entry(input_frame, width=50)
        self.edge_entry.grid(row=1, column=0, pady=5, sticky="ew")
        self.edge_entry.focus()

        # Compute button
        compute_btn = ttk.Button(
            input_frame, text="Compute", command=self.compute_topo
        )
        compute_btn.grid(row=2, column=0, pady=5, sticky="e")

        # Result label
        self.result_var = tk.StringVar()
        result_label = ttk.Label(
            self, textvariable=self.result_var, padding="10"
        )
        result_label.grid(row=1, column=0, sticky="w")

    def compute_topo(self):
        '''
        Callback for the Compute button.
        Parses the input, runs the topological sort, and displays
        the result or an error message.
        '''
        edges_str = self.edge_entry.get().strip()
        try:
            graph = Graph(edges_str)
            order = graph.topological_sort()
            if order is None:
                self.result_var.set("CYCLE")
            else:
                self.result_var.set(" ".join(order))
        except Exception as exc:
            messagebox.showerror("Error", str(exc))
```


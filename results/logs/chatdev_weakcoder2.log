'''
main.py
Entry point for the Nth Prime Finder application.
'''
import sys
import argparse
from prime_utils import nth_prime
from gui import PrimeGUI

def main():
    parser = argparse.ArgumentParser(description="Find the n-th prime number.")
    parser.add_argument('n', nargs='?', help="Positive integer n (1-indexed).")
    args = parser.parse_args()
    if args.n is not None:
        try:
            n = int(args.n)
            if n < 1:
                raise ValueError
            prime = nth_prime(n)
            print(prime)
        except ValueError:
            print("Error: n must be a positive integer.", file=sys.stderr)
            sys.exit(1)
    else:
        # No command-line argument; launch GUI
        app = PrimeGUI()
        app.mainloop()

if __name__ == "__main__":
    main()
```

prime_utils.py
```python
'''
prime_utils.py
Utility functions for prime number calculations.
'''
def is_prime(num: int) -> bool:
    '''Return True if num is a prime number.'''
    if num <= 1:
        return False
    if num <= 3:
        return True
    if num % 2 == 0 or num % 3 == 0:
        return False
    i = 5
    while i * i <= num:
        if num % i == 0 or num % (i + 2) == 0:
            return False
        i += 6
    return True

def nth_prime(n: int) -> int:
    '''Return the n-th prime number (1-indexed).'''
    if n < 1:
        raise ValueError("n must be a positive integer")
    count = 0
    candidate = 2
    while True:
        if is_prime(candidate):
            count += 1
            if count == n:
                return candidate
        candidate += 1
```

gui.py
```python
'''
gui.py
Tkinter GUI for entering n and displaying the n-th prime number.
'''
import tkinter as tk
from tkinter import ttk, messagebox
from prime_utils import nth_prime

class PrimeGUI(tk.Tk):
    '''Main application window.'''
    def __init__(self):
        super().__init__()
        self.title("Nth Prime Finder")
        self.geometry("300x150")
        self.resizable(False, False)
        self.create_widgets()

    def create_widgets(self):
        '''Create and layout widgets.'''
        frame = ttk.Frame(self, padding="10")
        frame.pack(fill=tk.BOTH, expand=True)
        ttk.Label(frame, text="Enter n:").grid(row=0, column=0, sticky=tk.W, pady=5)
        self.n_entry = ttk.Entry(frame, width=20)
        self.n_entry.grid(row=0, column=1, pady=5)
        self.n_entry.focus()
        self.compute_btn = ttk.Button(frame, text="Compute", command=self.compute_prime)
        self.compute_btn.grid(row=1, column=0, columnspan=2, pady=10)
        self.result_var = tk.StringVar(value="Result will appear here")
        ttk.Label(frame, textvariable=self.result_var, foreground="blue").grid(row=2, column=0, columnspan=2, pady=5)

    def compute_prime(self):
        '''Handle compute button click.'''
        n_str = self.n_entry.get()
        try:
            n = int(n_str)
            if n < 1:
                raise ValueError
        except ValueError:
            messagebox.showerror("Invalid input", "Please enter a positive integer.")
            return
        try:
            prime = nth_prime(n)
            self.result_var.set(f"The {n}-th prime is {prime}")
        except Exception as e:
            messagebox.showerror("Error", str(e))

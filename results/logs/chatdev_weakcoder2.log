## `main.py`

```python
#!/usr/bin/env python3
'''
main.py

Entry point for the Roman numeral converter application.
If a Roman numeral is supplied as a command‑line argument, its integer value is printed.
Otherwise, a Tkinter GUI is launched for interactive use.
'''

import sys
from roman_converter import RomanConverter
from gui import RomanConverterGUI
import tkinter as tk

def main() -> None:
    """
    Main function that handles command‑line usage or launches the GUI.
    """
    if len(sys.argv) > 1:
        roman_numeral = sys.argv[1]
        try:
            value = RomanConverter.roman_to_int(roman_numeral)
            print(value)
        except ValueError as e:
            print(f"Error: {e}")
    else:
        root = tk.Tk()
        root.title("Roman Numeral Converter")
        RomanConverterGUI(root)
        root.mainloop()

if __name__ == "__main__":
    main()
```


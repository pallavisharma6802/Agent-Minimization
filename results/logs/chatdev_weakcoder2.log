#!/usr/bin/env python3
"""
main.py
Entry point for the RPN Calculator application.  
If a command‑line argument is supplied, it evaluates the RPN expression
and prints the integer result.  
Regardless of command‑line usage, it launches a Tkinter GUI that allows
interactive evaluation of RPN expressions.
"""
import sys
from evaluator import evaluate_rpn
from gui import RPNCalculatorGUI
def main() -> None:
    """
    Parse command‑line argument (if any) and evaluate the RPN expression.
    Then start the GUI event loop.
    """
    if len(sys.argv) > 1:
        expr = sys.argv[1]
        try:
            result = evaluate_rpn(expr)
            print(result)
        except Exception as exc:
            print(f"Error evaluating expression: {exc}", file=sys.stderr)
    # Launch the GUI
    app = RPNCalculatorGUI()
    app.mainloop()
if __name__ == "__main__":
    main()
```

evaluator.py
```python
"""
evaluator.py
Provides a single function `evaluate_rpn` that parses and evaluates
a Reverse Polish Notation expression consisting of integers and the
operators +, -, *, /. Division is performed as integer division
truncating toward zero.
"""
def evaluate_rpn(expression: str) -> int:
    """
    Evaluate a Reverse Polish Notation expression.
    Parameters
    ----------
    expression : str
        Space‑separated tokens representing an RPN expression.
        Tokens may be integers or one of '+', '-', '*', '/'.
    Returns
    -------
    int
        The integer result of evaluating the expression.
    Raises
    ------
    ValueError
        If the expression is malformed (e.g., insufficient operands,
        unknown token, or leftover operands after evaluation).
    ZeroDivisionError
        If a division by zero occurs.
    """
    if not expression.strip():
        raise ValueError("Empty expression")
    tokens = expression.split()
    stack = []
    for token in tokens:
        if token in {"+", "-", "*", "/"}:
            if len(stack) < 2:
                raise ValueError(f"Insufficient operands for operator '{token}'")
            b = stack.pop()
            a = stack.pop()
            if token == "+":
                stack.append(a + b)
            elif token == "-":
                stack.append(a - b)
            elif token == "*":
                stack.append(a * b)
            elif token == "/":
                if b == 0:
                    raise ZeroDivisionError("Division by zero")
                # Truncate toward zero
                stack.append(int(a / b))
        else:
            try:
                stack.append(int(token))
            except ValueError:
                raise ValueError(f"Invalid token '{token}'")
    if len(stack) != 1:
        raise ValueError("The expression has too many operands")
    return stack[0]
```

gui.py
```python
"""
gui.py
Tkinter GUI for the RPN Calculator.  
Provides an entry field for the user to type an RPN expression,
an "Evaluate" button, and a label that displays the result or an error
message.
"""
import tkinter as tk
from tkinter import ttk
from evaluator import evaluate_rpn
class RPNCalculatorGUI(tk.Tk):
    """
    Main application window for the RPN Calculator.
    """
    def __init__(self) -> None:
        super().__init__()
        self.title("RPN Calculator")
        self.resizable(False, False)
        self._create_widgets()
    def _create_widgets(self) -> None:
        """
        Create and layout the widgets: entry, button, and result label.
        """
        padding = {"padx": 10, "pady": 10}
        # Expression entry
        self.expr_var = tk.StringVar()
        expr_label = ttk.Label(self, text="RPN Expression:")
        expr_label.grid(row=0, column=0, sticky="W", **padding)
        self.expr_entry = ttk.Entry(self, textvariable=self.expr_var, width=40)
        self.expr_entry.grid(row=0, column=1, **padding)
        self.expr_entry.bind("<Return>", self._on_evaluate)
        # Evaluate button
        eval_button = ttk.Button(self, text="Evaluate", command=self._on_evaluate)
        eval_button.grid(row=0, column=2, **padding)
        # Result display
        self.result_var = tk.StringVar()
        result_label = ttk.Label(self, textvariable=self.result_var, foreground="blue")
        result_label.grid(row=1, column=0, columnspan=3, sticky="W", **padding)
    def _on_evaluate(self, event=None) -> None:
        """
        Callback for the Evaluate button or Return key.
        Retrieves the expression, evaluates it, and displays the result.
        """
        expr = self.expr_var.get().strip()
        if not expr:
            self.result_var.set("Please enter an expression.")
            return
        try:
            result = evaluate_rpn(expr)
            self.result_var.set(f"Result: {result}")
        except ZeroDivisionError:
            self.result_var.set("Error: Division by zero.")
        except ValueError as exc:
            self.result_var.set(f"Error: {exc}")
        except Exception as exc:
            self.result_var.set(f"Unexpected error: {exc}")

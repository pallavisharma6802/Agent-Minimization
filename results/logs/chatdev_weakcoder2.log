**gui.py**

```python
'''
gui.py

Tkinter GUI for the RPN Calculator.  
Provides an entry field for the expression, an "Evaluate" button,
and a label to display the result or error message.
'''

import tkinter as tk
from tkinter import ttk
from evaluator import evaluate_rpn

class RPNCalculatorGUI(tk.Tk):
    """
    Main application window for the RPN Calculator.
    """

    def __init__(self):
        super().__init__()
        self.title("RPN Calculator")
        self.resizable(False, False)
        self._create_widgets()

    def _create_widgets(self) -> None:
        """
        Create and layout the widgets: entry, button, and result label.
        """
        padding = {'padx': 10, 'pady': 10}

        # Expression entry
        self.expr_var = tk.StringVar()
        expr_label = ttk.Label(self, text="RPN Expression:")
        expr_label.grid(row=0, column=0, sticky="W", **padding)

        expr_entry = ttk.Entry(self, textvariable=self.expr_var, width=40)
        expr_entry.grid(row=0, column=1, **padding)
        expr_entry.focus()

        # Evaluate button
        eval_button = ttk.Button(self, text="Evaluate", command=self._on_evaluate)
        eval_button.grid(row=1, column=0, columnspan=2, **padding)

        # Result display
        self.result_var = tk.StringVar()
        result_label = ttk.Label(self, textvariable=self.result_var, foreground="blue")
        result_label.grid(row=2, column=0, columnspan=2, **padding)

    def _on_evaluate(self) -> None:
        """
        Callback for the Evaluate button. Parses the expression,
        evaluates it, and displays the result or an error message.
        """
        expr = self.expr_var.get()
        try:
            result = evaluate_rpn(expr)
            self.result_var.set(f"Result: {result}")
        except Exception as exc:
            self.result_var.set(f"Error: {exc}")
```


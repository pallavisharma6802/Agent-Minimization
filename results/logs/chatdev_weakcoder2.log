gui.py
```python
"""
gui.py
Tkinter GUI for the RPN Calculator.  
Provides an entry field for the user to type an RPN expression,
an "Evaluate" button, and a label that displays the result or an error
message.
"""
import tkinter as tk
from tkinter import ttk
from evaluator import evaluate_rpn
class RPNCalculatorGUI(tk.Tk):
    """
    Main application window for the RPN Calculator.
    """
    def __init__(self) -> None:
        super().__init__()
        self.title("RPN Calculator")
        self.resizable(False, False)
        self._create_widgets()
    def _create_widgets(self) -> None:
        """
        Create and layout the widgets: entry, button, and result label.
        """
        padding = {"padx": 10, "pady": 10}
        # Expression entry
        self.expr_var = tk.StringVar()
        expr_label = ttk.Label(self, text="RPN Expression:")
        expr_label.grid(row=0, column=0, sticky="W", **padding)
        self.expr_entry = ttk.Entry(self, textvariable=self.expr_var, width=40)
        self.expr_entry.grid(row=0, column=1, **padding)
        self.expr_entry.bind("<Return>", self._on_evaluate)
        # Evaluate button
        eval_button = ttk.Button(self, text="Evaluate", command=self._on_evaluate)
        eval_button.grid(row=0, column=2, **padding)
        # Result display
        self.result_var = tk.StringVar()
        result_label = ttk.Label(self, textvariable=self.result_var, foreground="blue")
        result_label.grid(row=1, column=0, columnspan=3, sticky="W", **padding)
    def _on_evaluate(self, event=None) -> None:
        """
        Callback for the Evaluate button or Return key.
        Retrieves the expression, evaluates it, and displays the result.
        """
        expr = self.expr_var.get().strip()
        if not expr:
            self.result_var.set("Please enter an expression.")
            return
        try:
            result = evaluate_rpn(expr)
            self.result_var.set(f"Result: {result}")
        except ZeroDivisionError:
            self.result_var.set("Error: Division by zero.")
        except ValueError as exc:
            self.result_var.set(f"Error: {exc}")
        except Exception as exc:
            self.result_var.set(f"Unexpected error: {exc}")

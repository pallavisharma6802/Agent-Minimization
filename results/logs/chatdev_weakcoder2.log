# main.py

'''
Entry point for the topological sorting tool.

If an edge string is supplied on the command line it prints the
result directly.  Otherwise it launches the Tkinter GUI.
'''

import sys

from graph import Graph
from gui import TopoSortGUI


def main():
    if len(sys.argv) > 1:
        # Command‑line mode
        edges_str = sys.argv[1]
        try:
            graph = Graph(edges_str)
            order = graph.topological_sort()
            if order is None:
                print("CYCLE")
            else:
                print(" ".join(order))
        except Exception as exc:
            print(f"ERROR: {exc}")
    else:
        # GUI mode
        app = TopoSortGUI()
        app.mainloop()


if __name__ == "__main__":
    main()
```


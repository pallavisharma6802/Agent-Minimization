### `gui.py`

```python
# gui.py

"""
GUI for the LRUCache.

Uses Tkinter to provide a simple interface where the user can
enter a semicolon‑separated list of commands, execute them, and
see the results.  The GUI re‑uses the same parsing logic as the
command‑line interface.
"""

import tkinter as tk
from tkinter import ttk, scrolledtext, messagebox
from typing import List, Tuple

from lru_cache import LRUCache


def parse_commands(command_str: str) -> List[Tuple[str, int, int]]:
    """
    Parse a semicolon‑separated command string into a list of tuples.

    Each tuple is either ('put', key, value) or ('get', key, None).

    Parameters
    ----------
    command_str : str
        Raw command string from the user.

    Returns
    -------
    List[Tuple[str, int, int]]
        Parsed commands.
    """
    commands: List[Tuple[str, int, int]] = []
    for part in command_str.split(';'):
        part = part.strip()
        if not part:
            continue
        tokens = part.split()
        if not tokens:
            continue
        cmd = tokens[0].lower()
        if cmd == 'put' and len(tokens) == 3:
            key, value = int(tokens[1]), int(tokens[2])
            commands.append(('put', key, value))
        elif cmd == 'get' and len(tokens) == 2:
            key = int(tokens[1])
            commands.append(('get', key, None))
        else:
            raise ValueError(f"Invalid command: '{part}'")
    return commands


class LRUCacheGUI(tk.Tk):
    """
    Tkinter application that lets the user interact with an LRUCache.
    """

    def __init__(self, capacity: int = 5):
        super().__init__()
        self.title("LRU Cache Demo")
        self.geometry("600x400")
        self.cache = LRUCache(capacity)

        # Input frame
        input_frame = ttk.Frame(self)
        input_frame.pack(fill=tk.X, padx=10, pady=10)

        ttk.Label(input_frame, text="Commands:").pack(side=tk.LEFT)
        self.command_entry = ttk.Entry(input_frame, width=80)
        self.command_entry.pack(side=tk.LEFT, padx=5)
        ttk.Button(input_frame, text="Execute", command=self.execute_commands).pack(side=tk.LEFT)

        # Output frame
        output_frame = ttk.Frame(self)
        output_frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)

        ttk.Label(output_frame, text="Results:").pack(anchor=tk.W)
        self.output_text = scrolledtext.ScrolledText(output_frame, wrap=tk.WORD, height=10)
        self.output_text.pack(fill=tk.BOTH, expand=True)

    def execute_commands(self) -> None:
        """Parse the command string, run it against the cache, and display results."""
        cmd_str = self.command_entry.get()
        try:
            commands = parse_commands(cmd_str)
        except ValueError as e:
            messagebox.showerror("Parsing Error", str(e))
            return

        results: List[int] = []
        for cmd, key, value in commands:
            if cmd == 'put':
                self.cache.put(key, value)
            else:  # get
                results.append(self.cache.get(key))

        # Display results
        self.output_text.delete(1.0, tk.END)
        self.output_text.insert(tk.END, ' '.join(map(str, results)))
```


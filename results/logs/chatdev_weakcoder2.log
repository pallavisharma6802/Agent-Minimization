"lru_cache.py
```python
'''
LRUCache implementation using collections.OrderedDict.
Provides O(1) get and put operations with automatic eviction of the
least‑recently‑used entry when capacity is exceeded.
'''
from collections import OrderedDict
from typing import Any
class LRUCache:
    """Least‑Recently‑Used (LRU) cache.
    Parameters
    ----------
    capacity : int
        Maximum number of key/value pairs the cache can hold.
    """
    def __init__(self, capacity: int):
        if capacity <= 0:
            raise ValueError("Capacity must be a positive integer")
        self.capacity: int = capacity
        self.cache: OrderedDict[int, Any] = OrderedDict()
    def get(self, key: int) -> int:
        """Return the value for *key* if present, else -1.
        Moves the key to the end to mark it as recently used.
        """
        if key not in self.cache:
            return -1
        value = self.cache.pop(key)
        self.cache[key] = value  # re‑insert to mark as most recent
        return value
    def put(self, key: int, value: int) -> None:
        """Insert or update the key/value pair.
        If the key already exists, it is updated and marked as most recent.
        If the cache is full, the least‑recently‑used entry is evicted.
        """
        if key in self.cache:
            self.cache.pop(key)
        elif len(self.cache) >= self.capacity:
            # popitem(last=False) pops the first item (LRU)
            self.cache.popitem(last=False)
        self.cache[key] = value
```

cache_app.py
```python
'''
Utility module that parses a semicolon‑separated command string
and executes it against an LRUCache instance.
Commands:
    put <key> <value>
    get <key>
'''
from typing import List
from lru_cache import LRUCache
def process_commands(command_str: str, capacity: int = 2) -> List[int]:
    """
    Execute a series of cache commands.
    Parameters
    ----------
    command_str : str
        Semicolon‑separated list of commands, e.g.
        'put 1 1;put 2 2;get 1;put 3 3;get 2;get 3'
    capacity : int, optional
        Cache capacity. Defaults to 2.
    Returns
    -------
    List[int]
        Results of each `get` command in the order they were executed.
    """
    cache = LRUCache(capacity)
    results: List[int] = []
    # Split on ';' and strip whitespace
    commands = [c.strip() for c in command_str.split(';') if c.strip()]
    for cmd in commands:
        parts = cmd.split()
        if not parts:
            continue
        action = parts[0].lower()
        if action == 'put' and len(parts) == 3:
            key, value = int(parts[1]), int(parts[2])
            cache.put(key, value)
        elif action == 'get' and len(parts) == 2:
            key = int(parts[1])
            results.append(cache.get(key))
        else:
            # Ignore malformed commands silently
            pass
    return results
```

main.py
```python
'''
Command‑line interface for the LRUCache.
Usage:
    python main.py "put 1 1;put 2 2;get 1;put 3 3;get 2;get 3"
If no command string is supplied, a Tkinter GUI is launched.
'''
import sys
from cache_app import process_commands
from lru_cache import LRUCache  # Explicitly exposing LRUCache as requested
# Expose LRUCache at the module level of main.py
__all__ = ['LRUCache', 'main']
def main() -> None:
    if len(sys.argv) > 1:
        # CLI mode
        command_str = sys.argv[1]
        results = process_commands(command_str)
        print(' '.join(map(str, results)))
    else:
        # GUI mode (with fallback if tkinter/gui is unavailable)
        try:
            from gui import run_gui
            run_gui()
        except (ImportError, ModuleNotFoundError) as e:
            print("GUI could not be launched (Tkinter may not be installed).")
            print("Usage: python main.py \"<commands>\"")
            sys.exit(1)
if __name__ == "__main__":
    main()
```

gui.py
```python
'''
Tkinter GUI for interacting with the LRUCache.
Features:
    • Set cache capacity
    • Enter semicolon‑separated commands
    • View space‑joined results of all `get` operations
'''
import tkinter as tk
from tkinter import ttk
from cache_app import process_commands
class LRUCacheGUI:
    """Main application window."""
    def __init__(self, master: tk.Tk):
        self.master = master
        master.title("LRU Cache Demo")
        # --- Capacity ----------------------------------------------------
        ttk.Label(master, text="Capacity:").grid(row=0, column=0, sticky='w')
        self.capacity_var = tk.IntVar(value=2)
        ttk.Entry(master, textvariable=self.capacity_var, width=5).grid(
            row=0, column=1, sticky='w'
        )
        # --- Command Entry -----------------------------------------------
        ttk.Label(master, text="Commands:").grid(row=1, column=0, sticky='w')
        self.command_entry = ttk.Entry(master, width=50)
        self.command_entry.grid(row=1, column=1, columnspan=3, sticky='we')
        # --- Run Button --------------------------------------------------
        ttk.Button(master, text="Run", command=self.run_command).grid(
            row=2, column=1, pady=5
        )
        # --- Output ------------------------------------------------------
        ttk.Label(master, text="Output:").grid(row=3, column=0, sticky='nw')
        self.output_text = tk.Text(master, height=5, width=60)
        self.output_text.grid(row=3, column=1, columnspan=3, sticky='we')
        # --- Layout ------------------------------------------------------
        master.columnconfigure(1, weight=1)
        master.columnconfigure(2, weight=1)
        master.columnconfigure(3, weight=1)
    def run_command(self) -> None:
        """Parse the command string and display results."""
        capacity = self.capacity_var.get()
        command_str = self.command_entry.get()
        results = process_commands(command_str, capacity=capacity)
        self.output_text.delete(1.0, tk.END)
        self.output_text.insert(tk.END, ' '.join(map(str, results)))
def run_gui() -> None:
    """Launch the Tkinter event loop."""
    root = tk.Tk()
    app = LRUCacheGUI(root)
    root.mainloop()

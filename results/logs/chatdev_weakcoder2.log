### `gui.py`

```python
# gui.py

'''
GUIApp
======

Tkinter based GUI that allows the user to input an edge string,
compute a topological order, and display the result.
'''

import tkinter as tk
from tkinter import ttk, messagebox

from graph import Graph
from sorter import TopologicalSorter


class GUIApp:
    '''
    Main application window.
    '''

    def __init__(self, root: tk.Tk):
        self.root = root
        self.root.title("Topological Sorter")

        # Input frame
        input_frame = ttk.Frame(root, padding="10")
        input_frame.grid(row=0, column=0, sticky="ew")

        ttk.Label(input_frame, text="Edge string:").grid(row=0, column=0, sticky="w")
        self.edge_entry = ttk.Entry(input_frame, width=50)
        self.edge_entry.grid(row=0, column=1, sticky="ew")
        input_frame.columnconfigure(1, weight=1)

        # Compute button
        compute_btn = ttk.Button(input_frame, text="Compute", command=self.compute)
        compute_btn.grid(row=0, column=2, padx=5)

        # Result frame
        result_frame = ttk.Frame(root, padding="10")
        result_frame.grid(row=1, column=0, sticky="ew")

        ttk.Label(result_frame, text="Result:").grid(row=0, column=0, sticky="w")
        self.result_var = tk.StringVar()
        self.result_label = ttk.Label(result_frame, textvariable=self.result_var, foreground="blue")
        self.result_label.grid(row=0, column=1, sticky="w")

    def compute(self):
        edge_str = self.edge_entry.get().strip()
        if not edge_str:
            messagebox.showwarning("Input required", "Please enter an edge string.")
            return

        try:
            graph = Graph(edge_str)
            order = TopologicalSorter.sort(graph)
            if order is None:
                self.result_var.set("CYCLE")
            else:
                self.result_var.set(' '.join(order))
        except ValueError as e:
            messagebox.showerror("Invalid input", str(e))
```


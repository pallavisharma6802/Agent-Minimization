# graph.py

'''
Graph representation and topological sorting.

The Graph class accepts an edge string in the format
'a>b,a>c,b>d,c>d' and builds an adjacency list and indegree
dictionary.  The topological_sort method implements Kahn's
algorithm using a min‑heap to always pick the lexicographically
smallest available node.  If a cycle is detected the method
returns None.
'''

import heapq
from collections import defaultdict
from typing import Dict, List, Optional, Set


class Graph:
    '''
    Represents a directed graph defined by an edge string.
    '''

    def __init__(self, edges_str: str):
        '''
        Parse the edge string and build the graph.

        Parameters
        ----------
        edges_str : str
            Edge list in the form 'a>b,a>c,b>d,c>d'.
        '''
        self.adj: Dict[str, Set[str]] = defaultdict(set)
        self.indegree: Dict[str, int] = defaultdict(int)
        self.nodes: Set[str] = set()

        if edges_str:
            edges = [e.strip() for e in edges_str.split(',') if e.strip()]
            for edge in edges:
                if '>' not in edge:
                    raise ValueError(f"Invalid edge format: '{edge}'")
                src, dst = [part.strip() for part in edge.split('>')]
                if not src or not dst:
                    raise ValueError(f"Empty node in edge: '{edge}'")
                self.adj[src].add(dst)
                self.indegree[dst] += 1
                self.nodes.update([src, dst])

        # Ensure all nodes appear in indegree dict
        for node in self.nodes:
            self.indegree.setdefault(node, 0)

    def topological_sort(self) -> Optional[List[str]]:
        '''
        Perform a lexicographically sorted topological sort.

        Returns
        -------
        list[str] | None
            A list of nodes in topological order, or None if a cycle
            is detected.
        '''
        # Min‑heap of nodes with zero indegree
        zero_indeg = [node for node in self.nodes if self.indegree[node] == 0]
        heapq.heapify(zero_indeg)

        order: List[str] = []

        while zero_indeg:
            node = heapq.heappop(zero_indeg)
            order.append(node)

            for neighbor in self.adj.get(node, []):
                self.indegree[neighbor] -= 1
                if self.indegree[neighbor] == 0:
                    heapq.heappush(zero_indeg, neighbor)

        if len(order) != len(self.nodes):
            # Cycle detected
            return None
        return order
```


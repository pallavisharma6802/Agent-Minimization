# lru_cache.py

"""
LRUCache implementation.

Provides a fixed‑size cache that evicts the least‑recently‑used entry
when the capacity is exceeded.  The cache supports O(1) `get` and
`put` operations using an OrderedDict.
"""

from collections import OrderedDict
from typing import Any, Dict


class LRUCache:
    """
    A Least‑Recently‑Used (LRU) cache.

    Parameters
    ----------
    capacity : int
        Maximum number of items the cache can hold.

    Methods
    -------
    get(key: int) -> int
        Return the value for `key` if present, otherwise -1.
    put(key: int, value: int) -> None
        Insert or update the value for `key`.  Evicts the LRU entry if
        the cache is full.
    """

    def __init__(self, capacity: int):
        if capacity <= 0:
            raise ValueError("Capacity must be a positive integer")
        self.capacity: int = capacity
        self.cache: OrderedDict[int, int] = OrderedDict()

    def get(self, key: int) -> int:
        """Return the value for `key` if present, otherwise -1."""
        if key not in self.cache:
            return -1
        # Move key to the end to mark it as recently used
        value = self.cache.pop(key)
        self.cache[key] = value
        return value

    def put(self, key: int, value: int) -> None:
        """Insert or update the value for `key`. Evict LRU if needed."""
        if key in self.cache:
            # Remove old entry so we can re‑insert it at the end
            self.cache.pop(key)
        elif len(self.cache) >= self.capacity:
            # Evict the least recently used item (first item)
            self.cache.popitem(last=False)
        self.cache[key] = value
```


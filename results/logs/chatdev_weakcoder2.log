**main.py**

```python
'''
main.py

Entry point for the Nth Prime Calculator.
If a command line argument is provided, prints the nth prime to stdout.
Otherwise launches the GUI.
'''

import sys
from prime_utils import nth_prime

def main():
    if len(sys.argv) > 1:
        n_str = sys.argv[1]
        if not n_str.isdigit():
            print("Error: n must be a positive integer.", file=sys.stderr)
            sys.exit(1)
        n = int(n_str)
        try:
            prime = nth_prime(n)
            print(prime)
        except Exception as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
    else:
        # Launch GUI
        try:
            import gui
            app = gui.PrimeGUI()
            app.mainloop()
        except Exception as e:
            print(f"Failed to launch GUI: {e}", file=sys.stderr)
            sys.exit(1)

if __name__ == "__main__":
    main()
```

---

**prime_utils.py**

```python
'''
prime_utils.py

Utility functions for prime number calculations.
'''

import math

def is_prime(num: int) -> bool:
    """Return True if num is a prime number, else False."""
    if num <= 1:
        return False
    if num <= 3:
        return True
    if num % 2 == 0 or num % 3 == 0:
        return False
    i = 5
    w = 2
    while i * i <= num:
        if num % i == 0:
            return False
        i += w
        w = 6 - w
    return True

def nth_prime(n: int) -> int:
    """Return the n-th prime number (1-indexed)."""
    if n < 1:
        raise ValueError("n must be a positive integer")
    count = 0
    candidate = 2
    while True:
        if is_prime(candidate):
            count += 1
            if count == n:
                return candidate
        candidate += 1
```


## `roman_converter.py`

```python
# roman_converter.py

'''
roman_converter.py

Provides the RomanConverter class with a static method to convert Roman numerals
to integers, supporting subtractive notation (IV, IX, XL, XC, CD, CM).
'''

class RomanConverter:
    """
    Utility class for converting Roman numerals to integers.
    """

    _roman_map = {
        'I': 1,
        'V': 5,
        'X': 10,
        'L': 50,
        'C': 100,
        'D': 500,
        'M': 1000
    }

    @staticmethod
    def roman_to_int(s: str) -> int:
        """
        Convert a Roman numeral string to its integer value.

        Parameters
        ----------
        s : str
            Roman numeral string (e.g., 'MCMXCIV').

        Returns
        -------
        int
            Integer value of the Roman numeral.

        Raises
        ------
        ValueError
            If the input contains invalid characters or is empty.
        """
        if not s:
            raise ValueError("Input string is empty")

        s = s.upper()
        total = 0
        i = 0
        while i < len(s):
            if s[i] not in RomanConverter._roman_map:
                raise ValueError(f"Invalid Roman numeral character: '{s[i]}'")

            current_val = RomanConverter._roman_map[s[i]]

            # Look ahead to determine if this is a subtractive pair
            if i + 1 < len(s):
                next_char = s[i + 1]
                if next_char not in RomanConverter._roman_map:
                    raise ValueError(f"Invalid Roman numeral character: '{next_char}'")
                next_val = RomanConverter._roman_map[next_char]

                if current_val < next_val:
                    total += next_val - current_val
                    i += 2
                    continue

            total += current_val
            i += 1

        return total
```


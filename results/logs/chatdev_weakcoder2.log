# graph.py
'''
Graph
=====
Represents a directed graph built from an edge string of the form
'a>b,a>c,b>d,c>d'.  Provides adjacency list and indegree mapping
required for topological sorting.
'''
from collections import defaultdict
from typing import Dict, Set, List
class Graph:
    '''
    Graph representation.
    Attributes
    ----------
    adjacency : Dict[str, Set[str]]
        Mapping from a node to the set of its outgoing neighbors.
    indegree : Dict[str, int]
        Mapping from a node to its indegree count.
    nodes : Set[str]
        Set of all nodes in the graph.
    '''
    def __init__(self, edge_str: str):
        '''
        Construct a graph from an edge string.
        Parameters
        ----------
        edge_str : str
            Edge list string, e.g. 'a>b,a>c,b>d,c>d'.
        '''
        self.adjacency: Dict[str, Set[str]] = defaultdict(set)
        self.indegree: Dict[str, int] = defaultdict(int)
        self.nodes: Set[str] = set()
        if not edge_str:
            return
        edges = edge_str.split(',')
        for edge in edges:
            if '>' not in edge:
                raise ValueError(f"Invalid edge format: '{edge}'. Expected 'u>v'.")
            u, v = edge.split('>', 1)
            u, v = u.strip(), v.strip()
            if not u or not v:
                raise ValueError(f"Empty node in edge: '{edge}'.")
            self.nodes.update([u, v])
            self.adjacency[u].add(v)
            self.indegree[v] += 1
            # Ensure all nodes appear in indegree map
            self.indegree.setdefault(u, self.indegree.get(u, 0))
    def __repr__(self):
        return f"Graph(nodes={self.nodes}, adjacency={dict(self.adjacency)})"

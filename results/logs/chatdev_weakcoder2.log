### `main.py`

```python
# main.py

"""
Entry point for the LRUCache application.

If a command string is supplied as the first command‑line argument,
the program processes it and prints the space‑joined results of
each `get` operation.  If no argument is supplied, a Tkinter GUI
is launched for interactive use.
"""

import sys
from typing import List, Tuple

from lru_cache import LRUCache
from gui import LRUCacheGUI, parse_commands


def process_commands(command_str: str, capacity: int = 5) -> List[int]:
    """
    Execute a semicolon‑separated list of commands on an LRUCache.

    Parameters
    ----------
    command_str : str
        Raw command string (e.g. 'put 1 1;put 2 2;get 1').
    capacity : int, optional
        Cache capacity (default 5).

    Returns
    -------
    List[int]
        Results of each `get` command.
    """
    cache = LRUCache(capacity)
    results: List[int] = []

    for cmd, key, value in parse_commands(command_str):
        if cmd == 'put':
            cache.put(key, value)
        else:  # get
            results.append(cache.get(key))

    return results


def main() -> None:
    """
    Main entry point.

    - If a command string is provided on the command line, process it
      and print the results.
    - Otherwise, launch the GUI.
    """
    if len(sys.argv) > 1:
        # Command‑line mode
        command_str = sys.argv[1]
        try:
            results = process_commands(command_str)
            print(' '.join(map(str, results)))
        except Exception as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
    else:
        # GUI mode
        app = LRUCacheGUI(capacity=5)
        app.mainloop()


if __name__ == "__main__":
    main()
```


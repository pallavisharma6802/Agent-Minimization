import sys

def roman_to_int(roman: str) -> int:
    """
    Converts a Roman numeral string to its corresponding integer value.
    Handles standard subtractive forms: IV=4, IX=9, XL=40, XC=90, CD=400, CM=900.
    """
    # Map of Roman numeral characters to their integer values
    roman_map = {
        'I': 1,
        'V': 5,
        'X': 10,
        'L': 50,
        'C': 100,
        'D': 500,
        'M': 1000
    }
    
    total = 0
    prev_value = 0
    
    # Process the string from right to left to easily handle subtractive forms
    for char in reversed(roman.upper()):
        value = roman_map.get(char)
        if value is None:
            raise ValueError(f"Invalid Roman numeral character: {char}")
        
        # If the current value is less than the previous value, subtract it (e.g., IV -> V(5) - I(1) = 4)
        if value < prev_value:
            total -= value
        else:
            total += value
            prev_value = value
            
    return total

def main():
    # Ensure that an argument is provided
    if len(sys.argv) < 2:
        print("Usage: python main.py <ROMAN_NUMERAL>")
        sys.exit(1)
        
    roman_input = sys.argv[1].strip()
    
    if not roman_input:
        print("Error: Roman numeral input cannot be empty.")
        sys.exit(1)
        
    try:
        result = roman_to_int(roman_input)
        print(result)
    except ValueError as e:
        print(f"Error: {e}")
        sys.exit(1)

if __name__ == '__main__':
    main()
```


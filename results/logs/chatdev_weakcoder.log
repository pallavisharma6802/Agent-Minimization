'''
This module takes a positive integer n as a command-line argument
and prints the n-th prime number (1-indexed, so n=1 -> 2).
'''

import sys

def is_prime(num):
    """Helper function to check if a number is prime."""
    if num < 2:
        return False
    if num == 2:
        return True
    if num % 2 == 0:
        return False
    # Check odd factors up to the square root of num
    for i in range(3, int(num**0.5) + 1, 2):
        if num % i == 0:
            return False
    return True

def find_nth_prime(n):
    """Finds and returns the n-th prime number (1-indexed)."""
    if n < 1:
        raise ValueError("n must be a positive integer (>= 1).")
    
    if n == 1:
        return 2
    
    count = 1
    candidate = 3
    while count < n:
        if is_prime(candidate):
            count += 1
            if count == n:
                return candidate
        candidate += 2  # Skip even numbers

def main():
    # Ensure the argument is provided
    if len(sys.argv) < 2:
        print("Error: Please provide a positive integer n as a command-line argument.", file=sys.stderr)
        print("Usage: python main.py <positive_integer>", file=sys.stderr)
        sys.exit(1)
    
    # Parse and validate the input argument
    try:
        n = int(sys.argv[1])
        if n <= 0:
            raise ValueError
    except ValueError:
        print("Error: The argument must be a positive integer (greater than 0).", file=sys.stderr)
        sys.exit(1)
    
    # Calculate and print the n-th prime
    nth_prime = find_nth_prime(n)
    print(nth_prime)

if __name__ == '__main__':
    main()

'''
Calculates and prints the nth prime number (1-indexed, so n=1 -> 2)
'''
def is_prime(num):
    if num <= 1:
        raise ValueError("n must be a positive integer (n >= 1)")
def find_nth_prime(n):
    prime_numbers = [2]
    for num in range(3, int(n ** 0.5) + 1):
        is_prime(num)
        if is_prime(num):
            prime_numbers.append(num)
    if len(prime_numbers) == 0:
        raise ValueError("n is too large for the given algorithm")
    return prime_numbers[n - 1]

if __name__ == '__main__':
    n = int(input("Enter the value of n: "))
    result = find_nth_prime(n)
    print("The", n, "th prime number is:", result)

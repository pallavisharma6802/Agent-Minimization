import sys

def is_prime(num):
    """Helper function to check if a number is prime."""
    if num < 2:
        return False
    if num == 2:
        return True
    if num % 2 == 0:
        return False
    # Check odd factors up to the square root of num
    for i in range(3, int(num**0.5) + 1, 2):
        if num % i == 0:
            return False
    return True

def find_nth_prime(n):
    """Finds and returns the n-th prime number (1-indexed)."""
    if n <= 0:
        raise ValueError("n must be a positive integer (greater than 0).")
    
    count = 0
    candidate = 1
    while count < n:
        candidate += 1
        if is_prime(candidate):
            count += 1
    return candidate


import sys
import argparse
from prime_utils import nth_prime
from gui import PrimeGUI
def main():
    parser = argparse.ArgumentParser(description="Find the n-th prime number.")
    parser.add_argument('n', nargs='?', help="Positive integer n (1-indexed).")

'''
Calculates and prints the n-th prime number (1-indexed, so n=1 -> 2)
from a command-line argument.
'''
import sys

def is_prime(num):
    """
    Checks if a number is prime.
    Returns True if prime, False otherwise.
    """
    if num <= 1:
        return False
    if num == 2:
        return True
    if num % 2 == 0:
        return False
    # Check odd factors up to the square root of num
    for i in range(3, int(num**0.5) + 1, 2):
        if num % i == 0:
            return False
    return True

def find_nth_prime(n):
    """
    Finds and returns the n-th prime number (1-indexed).
    """
    count = 0
    candidate = 1
    while count < n:
        candidate += 1
        if is_prime(candidate):
            count += 1
    return candidate

def main():
    # Ensure an argument is provided
    if len(sys.argv) < 2:
        print("Error: Please provide a positive integer n as a command-line argument.", file=sys.stderr)
        print("Usage: python main.py <n>", file=sys.stderr)
        sys.exit(1)
    
    # Parse and validate the input argument
    try:
        n = int(sys.argv[1])
        if n <= 0:
            raise ValueError
    except ValueError:
        print("Error: The argument must be a positive integer (n >= 1).", file=sys.stderr)
        sys.exit(1)
        
    # Find and print the n-th prime
    nth_prime = find_nth_prime(n)
    print(nth_prime)

if __name__ == '__main__':
    main()
```


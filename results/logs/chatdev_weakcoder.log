import sys

def are_brackets_balanced(expression: str) -> bool:
    """
    Checks if all (), [], and {} brackets in the input string are balanced and correctly nested.
    All non-bracket characters are ignored.
    """
    # Map closing brackets to their corresponding opening brackets
    bracket_map = {')': '(', ']': '[', '}': '{'}
    opening_brackets = set(bracket_map.values())
    closing_brackets = set(bracket_map.keys())
    
    stack = []
    
    for char in expression:
        if char in opening_brackets:
            stack.append(char)
        elif char in closing_brackets:
            # If stack is empty or top of stack doesn't match the closing bracket
            if not stack or stack[-1] != bracket_map[char]:
                return False
            stack.pop()
            
    # If the stack is empty, all brackets were matched correctly
    return len(stack) == 0

def main():
    # Ensure that an argument is provided
    if len(sys.argv) < 2:
        print("False")
        return

    # Get the input string from command line arguments
    input_string = sys.argv[1]
    
    # Check brackets and print the result
    if are_brackets_balanced(input_string):
        print("True")
    else:
        print("False")

if __name__ == "__main__":
    main()
```


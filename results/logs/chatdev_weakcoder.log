                    ttk.Label(master, text="Commands:").grid(row=1, column=0, sticky='w', padx=5, pady=5)
                    self.command_entry = ttk.Entry(master, width=50)
                    self.command_entry.insert(0, "put 1 1;put 2 2;get 1;put 3 3;get 2;get 3")
                    self.command_entry.grid(row=1, column=1, columnspan=3, sticky='we', padx=5, pady=5)
                    
                    ttk.Button(master, text="Run", command=self.run_command).grid(row=2, column=1, pady=5)
                    
                    ttk.Label(master, text="Output:").grid(row=3, column=0, sticky='nw', padx=5, pady=5)
                    self.output_text = tk.Text(master, height=5, width=60)
                    self.output_text.grid(row=3, column=1, columnspan=3, sticky='we', padx=5, pady=5)
                    
                    master.columnconfigure(1, weight=1)

                def run_command(self) -> None:
                    try:
                        capacity = self.capacity_var.get()
                    except tk.TclError:
                        capacity = 2
                    command_str = self.command_entry.get()
                    results = process_commands(command_str, capacity=capacity)
                    self.output_text.delete(1.0, tk.END)
                    self.output_text.insert(tk.END, ' '.join(map(str, results)))

            root = tk.Tk()
            app = LRUCacheGUI(root)
            root.mainloop()
        except (ImportError, ModuleNotFoundError):
            print("Usage: python main.py \"<commands>\"")
            sys.exit(1)


if __name__ == "__main__":
